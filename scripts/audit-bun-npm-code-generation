#!/usr/bin/env ruby
# frozen_string_literal: true

require "date"
require "digest"
require "cgi"
require "json"
require "open3"
require "optparse"
require "pathname"
require "tempfile"

load File.expand_path("audit-bun-codegen-reexecution", __dir__)

module BunNpmCodeGenerationAudit
  class Error < StandardError; end

  REPO_ROOT = File.expand_path("..", __dir__)
  NPM_PACKAGE_JSON_PATTERN = %r{\.\./\.\./source/(?:node_modules|packages/bun-error/node_modules|src/node-fallbacks/node_modules)/[^\s:|]+/package\.json}
  LICENSE_PATTERN = /\A(?:licen[cs]e|copying|notice|copyright)(?:[-._].*)?\z/i
  SUPPLEMENTAL_TEXT_EVIDENCE = {
    ["peechy", "0.4.34"] => {
      "source_archive_sha256" => "135dcdcd42984756d18a31aedcb9a1b670261522542c6dc7c3fca6e1aa42534d",
      "declared_license" => "MIT",
      "repository" => "https://github.com/jarred-sumner/peechy",
      "registry_git_head" => "069e5cfcbf1dff9a738be759671ef0d15c2c9da4",
      "repository_license_commit" => "dba47f9680fdf7886fddaf6fc3589b845241eb83",
      "repository_license_path" => "LICENSE.md",
      "repository_license_sha256" => "a6f766e4ab93cbd6dbc17e58a3d33b09d09be18d2f67f3133005b038dbc5915e",
      "normalized_text_sha256" => "7e74f1d97feb9e6aa3affbefa74ef914361fe0f0e9a167c961913e7e9d7895be",
      "upstream_request" => { "attempted" => true, "available" => false, "reason" => "issues_disabled" },
      "npm_archive_text_present" => false,
      "exact_release_source_correspondence_verified" => false
    }
  }.freeze
  PACKAGE_TEXT_RESOLUTIONS = {
    ["constants-browserify", "1.0.0"] => {
      "package_text_path" => "README.md",
      "package_text_sha256" => "b06569bf170a015c56cbad9b45756519d0b8a682770fe30d66bc1e235e26196a",
      "source_archive_sha256" => "ea9307fd609ddce9497e3ca6b49e6102d7326bd337f66c10143b7b326f931f59",
      "repository" => "https://github.com/juliangruber/constants-browserify",
      "registry_git_head" => "e0ee990c75f3a0b3275e6bb2e3ff4d5d169d1b9d",
      "release_tag" => "v1.0.0",
      "release_commit" => "e0ee990c75f3a0b3275e6bb2e3ff4d5d169d1b9d",
      "repository_license_commit" => "49d435dd53bcf66d337dba96f979b6141582646b",
      "repository_license_path" => "LICENSE.md",
      "repository_license_sha256" => "d29c64dd9512b1ff684804b434a391e5b8bd36c23660c02238399b164681b74e",
      "normalized_text_sha256" => "8e18f8b0cece5054ff7fa4f523523733d0b21b1a0774d8d67d2ff1a2a8310ce1",
      "exact_release_source_correspondence_verified" => true
    }
  }.freeze
  SIDE_EFFECT_PRODUCERS = [
    {
      "name" => "bindgen",
      "edge_anchor" => "codegen/GeneratedBindings.cpp",
      "generator" => "src/codegen/bindgen.ts",
      "definition_sources" => %w[
        src/jsc/NodeModuleModule.bind.ts
        src/runtime/api/BunObject.bind.ts
      ],
      "side_effect_outputs" => %w[
        codegen/GeneratedBunObject.h
        codegen/GeneratedNodeModuleModule.h
      ]
    },
    {
      "name" => "bindgenv2",
      "edge_anchor" => "codegen/bindgen_generated.zig",
      "generator" => "src/codegen/bindgenv2/script.ts",
      "definition_sources" => %w[
        src/runtime/socket/SSLConfig.bindv2.ts
        src/runtime/socket/SocketConfig.bindv2.ts
      ],
      "side_effect_outputs" => %w[
        codegen/GeneratedALPNProtocols.h
        codegen/GeneratedSSLConfig.h
        codegen/GeneratedSSLConfigFile.h
        codegen/GeneratedSSLConfigSingleFile.h
        codegen/GeneratedSocketConfigBinaryType.h
        codegen/GeneratedSocketConfigHandlers.h
        codegen/GeneratedSocketConfigTLS.h
      ]
    }
  ].freeze

  module_function

  def sha256(path)
    Digest::SHA256.file(path).hexdigest
  end

  def path_set_digest(paths)
    Digest::SHA256.hexdigest(paths.sort.join("\n") + "\n")
  end

  def safe_relative_path?(path)
    candidate = Pathname(path.to_s)
    candidate.relative? && candidate.each_filename.none? { |part| [".", ".."].include?(part) }
  end

  def file_record(path, root)
    real = File.realpath(path)
    base = File.realpath(root)
    raise Error, "file escapes retained root: #{path}" unless real.start_with?("#{base}/")

    {
      "path" => real.delete_prefix("#{base}/"),
      "size_bytes" => File.size(real),
      "sha256" => sha256(real)
    }
  end

  def repo_record(path)
    file_record(path, REPO_ROOT)
  end

  def load_json(path, schema)
    receipt = JSON.parse(File.read(path))
    raise Error, "unexpected schema in #{path}" unless receipt.fetch("schema") == schema

    receipt
  end

  def parse_final_link(ninja)
    match = ninja.match(/^build bun-profile: link (.*?)(?=^  ldflags = )/m)
    raise Error, "cannot find final bun-profile link edge" unless match

    match[1].gsub(/\$\n\s*/, " ").split.take_while { |input| input != "|" }.select { |input| input.end_with?(".o") }
  end

  def parse_ninja_edges(ninja)
    edges = {}
    ninja.gsub(/\$\n\s*/, " ").lines.grep(/^build /).each do |line|
      outputs, rule_and_inputs = line.delete_prefix("build ").split(": ", 2)
      next unless rule_and_inputs

      rule, inputs = rule_and_inputs.split(" ", 2)
      explicit = inputs.to_s.split(/ \|\|? /, 2).first.to_s.split
      declared_outputs = outputs.split.reject { |output| output == "|" }
      declared_outputs.each do |output|
        raise Error, "duplicate Ninja output #{output}" if edges.key?(output)

        edges[output] = { "rule" => rule, "inputs" => explicit, "outputs" => declared_outputs }
      end
    end
    edges
  end

  def source_input_records(inputs, source_root, build_root)
    inputs.uniq.map do |input|
      path = File.expand_path(input, build_root)
      raise Error, "code-generation input is not a retained source file: #{input}" unless File.file?(path)

      file_record(path, source_root)
    end.sort_by { |record| record.fetch("path") }
  end

  def side_effect_provenance(source_root, build_root, edges, undeclared_outputs, generator_execution_reproduced:)
    expected_outputs = SIDE_EFFECT_PRODUCERS.flat_map { |producer| producer.fetch("side_effect_outputs") }.sort
    actual_outputs = undeclared_outputs.map { |record| record.fetch("path") }.sort
    raise Error, "unexpected undeclared code-generation outputs: #{actual_outputs.inspect}" unless actual_outputs == expected_outputs

    producers = SIDE_EFFECT_PRODUCERS.map do |definition|
      edge = edges.fetch(definition.fetch("edge_anchor"))
      input_records = source_input_records(edge.fetch("inputs"), source_root, build_root)
      input_paths = input_records.map { |record| record.fetch("path") }
      definition_sources = definition.fetch("definition_sources").map do |path|
        raise Error, "code-generation definition is not a Ninja input: #{path}" unless input_paths.include?(path)

        file_record(File.join(source_root, path), source_root)
      end
      generator = file_record(File.join(source_root, definition.fetch("generator")), source_root)
      raise Error, "code-generation generator is not a Ninja input: #{generator.fetch('path')}" unless input_paths.include?(generator.fetch("path"))

      {
        "name" => definition.fetch("name"),
        "ninja_rule" => edge.fetch("rule"),
        "ninja_declared_outputs" => edge.fetch("outputs"),
        "ninja_declared_output_paths_sha256" => path_set_digest(edge.fetch("outputs")),
        "ninja_explicit_inputs" => input_records,
        "ninja_explicit_input_paths_sha256" => path_set_digest(input_paths),
        "generator" => generator,
        "definition_sources" => definition_sources,
        "definition_source_paths_sha256" => path_set_digest(definition_sources.map { |record| record.fetch("path") }),
        "side_effect_outputs" => definition.fetch("side_effect_outputs"),
        "side_effect_output_paths_sha256" => path_set_digest(definition.fetch("side_effect_outputs")),
        "ninja_edge_declares_side_effect_outputs" => false,
        "producer_provenance_verified" => true
      }
    end

    {
      "schema" => "bun-codegen-side-effect-provenance/v1",
      "orchestrator" => file_record(File.join(source_root, "scripts/build/codegen.ts"), source_root),
      "write_helper" => file_record(File.join(source_root, "src/codegen/helpers.ts"), source_root),
      "header_count" => expected_outputs.length,
      "header_paths_sha256" => path_set_digest(expected_outputs),
      "ninja_output_edges_declared" => false,
      "generator_execution_reproduced" => generator_execution_reproduced,
      "producers" => producers
    }
  end

  def linked_codegen_dependencies(build_root, direct_objects)
    selected = direct_objects.to_h { |path| [path, true] }
    current = nil
    consumers = Hash.new { |hash, key| hash[key] = [] }
    command = ["ninja", "-C", build_root, "-t", "deps"]
    Open3.popen3(*command) do |stdin, stdout, stderr, wait|
      stdin.close
      stdout.each_line do |line|
        if (match = line.match(/^(.+): #deps /))
          current = selected[match[1]] ? match[1] : nil
        elsif current && (match = line.match(/^\s+(.+)$/))
          path = match[1]
          next unless File.file?(path)

          real = File.realpath(path)
          codegen_root = File.realpath(File.join(build_root, "codegen"))
          next unless real.start_with?("#{codegen_root}/")

          relative = real.delete_prefix("#{File.realpath(build_root)}/")
          consumers[relative] << current
        elsif line.strip.empty?
          current = nil
        end
      end
      error = stderr.read
      raise Error, "ninja dependency query failed: #{error}" unless wait.value.success?
    end
    consumers.transform_values { |values| values.uniq.sort }.sort.to_h
  end

  def selected_package_manifests(source_root, ninja)
    build_root = File.dirname(File.join(source_root, "placeholder"))
    ninja.gsub(/\$\n\s*/, " ").scan(NPM_PACKAGE_JSON_PATTERN).uniq.map do |token|
      path = File.expand_path(token.sub("../../source", source_root), build_root)
      raise Error, "declared npm package manifest is missing: #{path}" unless File.file?(path)

      path
    end.sort
  end

  def selected_expression(package_json, license_files)
    declaration = package_json["license"]
    return declaration if declaration.is_a?(String) && !declaration.empty?

    texts = license_files.map { |path| File.binread(path) }.join("\n")
    return "MIT" if texts.include?("Permission is hereby granted, free of charge")

    legacy = Array(package_json["licenses"]).map { |record| record.is_a?(Hash) ? record["type"] : nil }.compact.uniq
    return legacy.first if legacy.length == 1

    nil
  end

  def normalized_license_text(path)
    text = File.read(path)
    start = text.index("Copyright")
    raise Error, "license text has no copyright marker: #{path}" unless start

    CGI.unescapeHTML(text[start..]).gsub(/\s+/, " ").strip
  end

  def supplemental_license_text(name, version, declaration, path, expected_directory:)
    evidence = SUPPLEMENTAL_TEXT_EVIDENCE[[name, version]]
    return unless evidence

    raise Error, "missing supplemental npm license text: #{name}@#{version}" unless path && File.file?(path)
    raise Error, "unexpected supplemental npm license text filename: #{name}@#{version}" unless File.basename(path) == "bun-1.3.14-peechy-0.4.34-LICENSE.md"
    unless File.dirname(File.realpath(path)) == File.realpath(expected_directory)
      raise Error, "supplemental npm license text is outside the checked source directory: #{name}@#{version}"
    end
    raise Error, "npm license declaration drifted: #{name}@#{version}" unless declaration == evidence.fetch("declared_license")
    raise Error, "supplemental npm license text drifted: #{name}@#{version}" unless sha256(path) == evidence.fetch("repository_license_sha256")
    unless Digest::SHA256.hexdigest(normalized_license_text(path)) == evidence.fetch("normalized_text_sha256")
      raise Error, "normalized supplemental npm license text drifted: #{name}@#{version}"
    end

    evidence.merge(
      "text" => {
        "path" => "packages/bun/#{File.basename(path)}",
        "size_bytes" => File.size(path),
        "sha256" => sha256(path)
      }
    )
  end

  def package_records(source_root, manifest_paths, supplemental_license_text_path:, supplemental_license_text_directory:)
    records = manifest_paths.map do |manifest_path|
      package_root = File.dirname(manifest_path)
      package_json = JSON.parse(File.read(manifest_path))
      name = package_json.fetch("name")
      version = package_json["version"]
      license_paths = Dir.children(package_root).grep(LICENSE_PATTERN).map { |entry| File.join(package_root, entry) }.select { |path| File.file?(path) }.sort
      resolution = PACKAGE_TEXT_RESOLUTIONS[[name, version]]
      if resolution
        text_path = File.join(package_root, resolution.fetch("package_text_path"))
        raise Error, "package-local license text is missing: #{name}@#{version}" unless File.file?(text_path)
        raise Error, "package-local license text drifted: #{name}@#{version}" unless sha256(text_path) == resolution.fetch("package_text_sha256")
        unless Digest::SHA256.hexdigest(normalized_license_text(text_path)) == resolution.fetch("normalized_text_sha256")
          raise Error, "normalized package-local license text drifted: #{name}@#{version}"
        end
        license_paths << text_path
        license_paths.sort!
      end
      expression = selected_expression(package_json, license_paths)
      raise Error, "npm package has no selected license expression: #{name}@#{version}" unless expression
      supplemental = supplemental_license_text(
        name,
        version,
        package_json["license"],
        supplemental_license_text_path,
        expected_directory: supplemental_license_text_directory
      )

      record = {
        "name" => name,
        "version" => version,
        "manifest" => file_record(manifest_path, source_root),
        "selected_expression" => expression,
        "license_files" => license_paths.map { |path| file_record(path, source_root) },
        "required_text_present" => license_paths.any? || !supplemental.nil?
      }
      record["supplemental_license_text"] = supplemental if supplemental
      if resolution
        record["license_text_resolution"] = resolution.reject { |key, _value| key == "package_text_path" || key == "package_text_sha256" }.merge(
          "package_text" => file_record(File.join(package_root, resolution.fetch("package_text_path")), source_root)
        )
      end
      record
    end
    identities = records.map { |record| [record["name"], record["version"], record.dig("manifest", "path")] }
    raise Error, "npm package manifest identities are not unique" unless identities.uniq.length == identities.length

    records.sort_by { |record| [record.fetch("name"), record.fetch("version").to_s, record.dig("manifest", "path")] }
  end

  def generate(proof_root:, source_inventory_path:, first_npm_path:, self_npm_path:, supplemental_license_text_path:, codegen_reexecution_path:, audit_date:)
    root = File.realpath(proof_root)
    source_root = File.join(root, "source")
    build_root = File.join(root, "build", "release-local")
    raise Error, "proof source root is missing" unless File.directory?(source_root)
    raise Error, "proof build root is missing" unless File.directory?(build_root)

    inventory = load_json(source_inventory_path, "bun-source-license-inventory/v2")
    first_npm = load_json(first_npm_path, "bun-npm-offline-install-proof/v2")
    self_npm = load_json(self_npm_path, "bun-npm-offline-install-proof/v2")
    codegen_reexecution = load_json(codegen_reexecution_path, "bun-codegen-reexecution-proof/v1")
    BunCodegenReexecutionAudit.validate!(codegen_reexecution)
    ninja_path = File.join(build_root, "build.ninja")
    ninja = File.read(ninja_path)
    direct_objects = parse_final_link(ninja)
    raise Error, "unexpected final direct object count" unless direct_objects.length == 1162

    consumers = linked_codegen_dependencies(build_root, direct_objects)
    raise Error, "no generated code is consumed by the final link" if consumers.empty?
    edges = parse_ninja_edges(ninja)
    generated_outputs = consumers.map do |path, object_paths|
      edge = edges[path]
      record = file_record(File.join(build_root, path), build_root)
      record.merge(
        "rule" => edge&.fetch("rule", nil),
        "producer_edge_declared" => !edge.nil?,
        "consumer_object_count" => object_paths.length,
        "consumer_objects_sha256" => path_set_digest(object_paths)
      )
    end
    undeclared_outputs = generated_outputs.reject { |record| record["producer_edge_declared"] }
    unless codegen_reexecution.dig("inputs", "build_ninja") == file_record(ninja_path, root)
      raise Error, "code-generation reexecution build graph mismatch"
    end
    producer_provenance = side_effect_provenance(
      source_root,
      build_root,
      edges,
      undeclared_outputs,
      generator_execution_reproduced: true
    )
    package_manifests = selected_package_manifests(source_root, ninja)
    packages = package_records(
      source_root,
      package_manifests,
      supplemental_license_text_path: supplemental_license_text_path,
      supplemental_license_text_directory: File.dirname(File.realpath(source_inventory_path))
    )
    missing_texts = packages.reject { |record| record["required_text_present"] }
    raise Error, "unexpected npm license-text gaps: #{missing_texts.map { |record| [record['name'], record['version']] }.inspect}" unless missing_texts.empty?

    {
      "schema" => "bun-npm-code-generation-closure/v2",
      "package" => "bun",
      "version" => inventory.fetch("release"),
      "rpm_release" => inventory.fetch("rpm_release"),
      "audit_date" => audit_date,
      "inputs" => {
        "source_license_inventory" => repo_record(source_inventory_path),
        "first_source_built_npm" => repo_record(first_npm_path),
        "self_source_built_npm" => repo_record(self_npm_path),
        "codegen_reexecution_proof" => repo_record(codegen_reexecution_path),
        "build_ninja" => file_record(ninja_path, root)
      },
      "final_link" => {
        "direct_object_count" => direct_objects.length,
        "direct_object_paths_sha256" => path_set_digest(direct_objects),
        "objects_consuming_generated_code" => consumers.values.flatten.uniq.length,
        "generated_output_count" => generated_outputs.length,
        "generated_output_paths_sha256" => path_set_digest(generated_outputs.map { |record| record.fetch("path") }),
        "undeclared_producer_output_count" => undeclared_outputs.length,
        "undeclared_producer_output_paths" => undeclared_outputs.map { |record| record.fetch("path") },
        "undeclared_header_side_effects" => producer_provenance,
        "generated_outputs" => generated_outputs
      },
      "npm" => {
        "selected_package_manifest_count" => packages.length,
        "selected_package_manifest_paths_sha256" => path_set_digest(packages.map { |record| record.dig("manifest", "path") }),
        "selected_packages" => packages,
        "selected_expression_counts" => packages.group_by { |record| record.fetch("selected_expression") }.transform_values(&:length).sort.to_h,
        "packages_with_required_text" => packages.count { |record| record["required_text_present"] },
        "packages_missing_required_text" => missing_texts.map { |record| { "name" => record["name"], "version" => record["version"], "evidence" => record["missing_text_evidence"] } }
      },
      "validation" => {
        "network_used" => false,
        "package_manager_invoked" => false,
        "build_invoked" => false,
        "source_built_npm_receipts_verified" => true,
        "declared_codegen_package_manifest_mapping_verified" => true,
        "linked_generated_output_mapping_verified" => true,
        "undeclared_header_generator_side_effects_verified" => true,
        "generator_execution_reproduced" => true,
        "generated_output_producer_edges_verified" => undeclared_outputs.empty?,
        "selected_package_license_expressions_verified" => true,
        "all_selected_package_license_texts_verified" => true,
        "final_npm_codegen_closure_verified" => false,
        "final_license_expression_verified" => false,
        "rpm_payload_license_verified" => false
      },
      "scope" => {
        "included" => "NPM package manifests declared by current code-generation install edges, generated outputs consumed by direct final-link objects, and exact upstream producer provenance for undeclared generated-header side effects",
        "excluded" => "distinct Ninja output edges for the nine headers, unselected installed package files, final WebKit terms, aggregate SPDX, final RPM payload, aarch64, and COPR acceptance"
      }
    }
  end

  def refresh_receipt(receipt_path:, source_inventory_path:, supplemental_license_text_path:, codegen_reexecution_path:, audit_date:)
    receipt = load_json(receipt_path, "bun-npm-code-generation-closure/v2")
    inventory = load_json(source_inventory_path, "bun-source-license-inventory/v2")
    codegen_reexecution = load_json(codegen_reexecution_path, "bun-codegen-reexecution-proof/v1")
    BunCodegenReexecutionAudit.validate!(codegen_reexecution)
    raise Error, "Bun release drifted while refreshing npm code-generation evidence" unless receipt.fetch("version") == inventory.fetch("release")

    peechy = receipt.dig("npm", "selected_packages").find { |record| record["name"] == "peechy" && record["version"] == "0.4.34" }
    raise Error, "checked receipt lacks the peechy record" unless peechy
    source_peechy = inventory.dig("npm", "records").find { |record| record["name"] == "peechy" && record["version"] == "0.4.34" }
    supplemental = supplemental_license_text(
      "peechy",
      "0.4.34",
      "MIT",
      supplemental_license_text_path,
      expected_directory: File.dirname(File.realpath(source_inventory_path))
    )
    raise Error, "source inventory peechy supplemental text mismatch" unless source_peechy && source_peechy["supplemental_license_text"] == supplemental

    if peechy["required_text_present"] == true
      raise Error, "checked peechy supplemental text drifted" unless peechy["supplemental_license_text"] == supplemental && !peechy.key?("missing_text_evidence")
    else
      raise Error, "checked receipt lacks the unresolved peechy evidence" unless peechy["required_text_present"] == false && peechy["missing_text_evidence"].is_a?(Hash)
      peechy.delete("missing_text_evidence")
      peechy["supplemental_license_text"] = supplemental
      peechy["required_text_present"] = true
    end
    receipt["rpm_release"] = inventory.fetch("rpm_release")
    receipt["audit_date"] = audit_date
    receipt.fetch("inputs")["source_license_inventory"] = repo_record(source_inventory_path)
    unless receipt.dig("inputs", "build_ninja") == codegen_reexecution.dig("inputs", "build_ninja")
      raise Error, "code-generation reexecution build graph mismatch"
    end
    receipt.fetch("inputs")["codegen_reexecution_proof"] = repo_record(codegen_reexecution_path)
    receipt.dig("final_link", "undeclared_header_side_effects")["generator_execution_reproduced"] = true
    receipt.fetch("npm")["packages_with_required_text"] = receipt.dig("npm", "selected_packages").count { |record| record["required_text_present"] }
    receipt.fetch("npm")["packages_missing_required_text"] = []
    receipt.fetch("validation")["all_selected_package_license_texts_verified"] = true
    receipt.fetch("validation")["generator_execution_reproduced"] = true
    receipt
  end

  def write_json(path, receipt)
    directory = File.dirname(path)
    Dir.mkdir(directory) unless Dir.exist?(directory)
    Tempfile.create(["bun-npm-code-generation", ".json"], directory) do |file|
      file.write(JSON.pretty_generate(receipt) + "\n")
      file.flush
      file.fsync
      File.chmod(0o644, file.path)
      File.rename(file.path, path)
    end
  end

  def main(argv)
    options = {}
    OptionParser.new do |parser|
      parser.on("--proof-root PATH") { |value| options[:proof_root] = value }
      parser.on("--source-inventory PATH") { |value| options[:source_inventory] = value }
      parser.on("--first-npm PATH") { |value| options[:first_npm] = value }
      parser.on("--self-npm PATH") { |value| options[:self_npm] = value }
      parser.on("--peechy-license PATH") { |value| options[:supplemental_license_text] = value }
      parser.on("--codegen-reexecution PATH") { |value| options[:codegen_reexecution] = value }
      parser.on("--refresh-receipt PATH") { |value| options[:refresh_receipt] = value }
      parser.on("--date YYYY-MM-DD") { |value| options[:audit_date] = value }
      parser.on("--output PATH") { |value| options[:output] = value }
      parser.on("--check") { options[:check] = true }
      parser.on("--receipt PATH") { |value| options[:receipt] = value }
    end.parse!(argv)
    required = options[:refresh_receipt] ? %i[source_inventory supplemental_license_text codegen_reexecution audit_date] : %i[proof_root source_inventory first_npm self_npm supplemental_license_text codegen_reexecution audit_date]
    required.each { |key| raise Error, "--#{key.to_s.tr('_', '-')} is required" unless options[key] }
    Date.iso8601(options.fetch(:audit_date))
    raise Error, "--output is required unless --check" unless options[:output] || options[:check]
    raise Error, "--receipt is required with --check" if options[:check] && !options[:receipt]

    receipt = if options[:refresh_receipt]
                refresh_receipt(
                  receipt_path: options.fetch(:refresh_receipt),
                  source_inventory_path: options.fetch(:source_inventory),
                  supplemental_license_text_path: options.fetch(:supplemental_license_text),
                  codegen_reexecution_path: options.fetch(:codegen_reexecution),
                  audit_date: options.fetch(:audit_date)
                )
              else
                generate(
                  proof_root: options.fetch(:proof_root),
                  source_inventory_path: options.fetch(:source_inventory),
                  first_npm_path: options.fetch(:first_npm),
                  self_npm_path: options.fetch(:self_npm),
                  supplemental_license_text_path: options.fetch(:supplemental_license_text),
                  codegen_reexecution_path: options.fetch(:codegen_reexecution),
                  audit_date: options.fetch(:audit_date)
                )
              end
    serialized = JSON.pretty_generate(receipt) + "\n"
    if options[:check]
      raise Error, "Bun npm code-generation closure differs from checked receipt" unless File.binread(options.fetch(:receipt)) == serialized
      puts "Verified Bun npm code-generation closure #{options.fetch(:receipt)}."
    else
      write_json(options.fetch(:output), receipt)
      puts "Wrote Bun npm code-generation closure to #{options.fetch(:output)}."
    end
  rescue Date::Error, JSON::ParserError, KeyError, Errno::ENOENT, Error => e
    warn "error: #{e.message}"
    exit 1
  end
end

BunNpmCodeGenerationAudit.main(ARGV) if $PROGRAM_NAME == __FILE__
