#!/usr/bin/env ruby
# frozen_string_literal: true

require "digest"
require "fileutils"
require "json"
require "open3"
require "optparse"
require "pathname"
require "rubygems/package"
require "set"
require "tmpdir"
require "zlib"

module XbergCargoClosure
  class Error < StandardError; end
  module_function

  NAME = "xberg"
  VERSION = "1.0.3"
  SOURCE_SHA256 = "238b8087a398b7753562b341abf082c8305a0359786424976909dc59b251058e"
  LOCK_SHA256 = "a8e11cce6425868975b00b13db98acf21a7bc2cb8e7fe143a80aa5ebfeddf667"
  PATCH_SHA256 = {
    "xberg-system-onnxruntime.patch" => "8b2e12741c26338aba679514262171fa2dfe2772a771255372df8d70144606ab",
    "xberg-fedora-onnxruntime-path.patch" => "b254d883cc4c0f15411eff83db7e0c072098b69fdd57e9aceaf99956e0e2121c",
    "xberg-dynamic-tesseract.patch" => "4e710a29f273b2cfa542ed8d6ee1f93a57c21168d49e7aa8b2cf5835ae297634",
    "xberg-selected-workspace.patch" => "054d4fa336f1a823babaa26eaad3c223fc0d54e6d4e898009aeec77e0301f0b2",
    "xberg-fedora-system-tessdata.patch" => "a27928a78f6f51296c0af68e82e9481e972a17c7e004b320d4bda600af9bcc20"
  }.freeze
  TARGET = "x86_64-unknown-linux-gnu"
  CLI_FEATURES = %w[formats analysis core-cli embeddings html url-ingestion liter-llm ocr paddle-ocr layout-detection chunking-tokenizers].freeze
  CLI_FEATURES_ARGUMENT = CLI_FEATURES.join(",")
  REGISTRY = "registry+https://github.com/rust-lang/crates.io-index"
  FORBIDDEN_IDENTITIES = Set[["intel-mkl-src", "0.8.1"], ["intel-mkl-tool", "0.8.1"]]
  LICENSE = /\A(?:licen[cs]e|copying|notice|authors)(?:[._-].*)?\z/i
  IDENTITY_SERIALIZATION = "UTF-8 sorted unique name\\tversion\\n lines"
  SELECTED_REGISTRY = 597
  VENDOR_REGISTRY = 1034
  RESOLVER_ONLY_REGISTRY = 437
  NORMAL_PACKAGES = 603
  NORMAL_BUILD_DEV_PACKAGES = 622
  NORMAL_IDENTITY_SHA256 = "9f7b783531614c0a9460001ddae469dcd53ec02b37453db77f00896c72cb89fe"
  NORMAL_BUILD_DEV_IDENTITY_SHA256 = "a49d533f5008678529641692a1951539120d35ccdb85197447c7aace5c954c91"

  def run!(*command, env: {}, chdir: nil)
    options = {}
    options[:chdir] = chdir if chdir
    output, error, status = Open3.capture3(env, *command, **options)
    return output if status.success?

    raise Error, "command failed: #{command.join(' ')}\n#{error.lines.last(20).join}#{output.lines.last(20).join}"
  end

  def sha256(path) = Digest::SHA256.file(path).hexdigest

  def cargo_selection_args = ["--no-default-features", "--features", CLI_FEATURES_ARGUMENT]

  def safe_path(path)
    clean = Pathname.new(path).cleanpath.to_s
    raise Error, "unsafe archive path #{path.inspect}" if Pathname.new(path).absolute? || clean == "." || clean == ".." || clean.start_with?("../")

    clean
  end

  def safe_tree!(root)
    Dir.glob(File.join(root, "**", "*"), File::FNM_DOTMATCH).sort.each do |path|
      next if %w[. ..].include?(File.basename(path))

      relative = path.delete_prefix("#{root}/")
      if File.lstat(path).symlink?
        target = File.readlink(path)
        resolved = Pathname.new(File.join(File.dirname(relative), target)).cleanpath.to_s
        raise Error, "symlink escape: #{relative}" if Pathname.new(target).absolute? || resolved == ".." || resolved.start_with?("../")
        next
      end
      raise Error, "unsafe source entry: #{relative}" unless File.directory?(path) || File.file?(path)
    end
  end

  def link_record(type, path, target, mode)
    { "path" => path, "mode" => mode, "type" => type.to_s, "target" => target }
  end

  def link_target(type, path, target)
    return [nil, "absolute-target"] if Pathname.new(target).absolute?

    resolved = type == :symlink ? Pathname.new(File.join(File.dirname(path), target)).cleanpath.to_s : safe_path(target)
    root = path.split("/", 2).first
    return [nil, "root-escaping-target"] if resolved == ".." || resolved.start_with?("../") || resolved.split("/", 2).first != root

    [resolved, nil]
  rescue Error
    [nil, "root-escaping-target"]
  end

  def safe_symlink_target(path, target)
    resolved, reason = link_target(:symlink, path, target)
    raise Error, "unsafe symlink target: #{path}" if reason

    resolved
  end

  def safe_hardlink_target(path, target)
    resolved, reason = link_target(:hardlink, path, target)
    raise Error, "unsafe hardlink target: #{path}" if reason

    resolved
  end

  def load_filter!(path)
    filter = JSON.parse(File.read(path))
    raise Error, "source filter schema mismatch" unless filter["schema"] == "agentlab-xberg-source-filter/v1"
    raise Error, "source filter release mismatch" unless filter.dig("release", "name") == NAME && filter.dig("release", "version") == VERSION
    source = filter["source"]
    raise Error, "source filter identity is incomplete" unless source.is_a?(Hash) && source.values_at("tag", "commit", "tree", "archive_sha256").all? { |value| value.is_a?(String) && !value.empty? }
    normalized = filter.fetch("unsafe_links").map do |link|
      raise Error, "source filter unsafe link is invalid" unless link.is_a?(Hash) && link.values_at("path", "mode", "type", "target", "reason").all? { |value| value.is_a?(String) && !value.empty? }
      link.slice("path", "mode", "type", "target", "reason")
    end
    raise Error, "source filter unsafe links are not sorted and unique" unless normalized == normalized.sort_by { |link| [link["path"], link["type"], link["target"]] } && normalized.uniq == normalized

    inventory = filter["archive_link_inventory"]
    inventory_keys = %w[symlinks hardlinks safe_in_root_links unsafe_links]
    raise Error, "source filter link inventory is invalid" unless inventory.is_a?(Hash) && inventory.keys.sort == inventory_keys.sort && inventory.values.all? { |value| value.is_a?(Integer) && value >= 0 }
    raise Error, "source filter link inventory totals are inconsistent" unless inventory.values_at("symlinks", "hardlinks").sum == inventory.values_at("safe_in_root_links", "unsafe_links").sum
    raise Error, "source filter unsafe-link count is inconsistent" unless inventory["unsafe_links"] == normalized.length

    { "unsafe_links" => normalized, "archive_link_inventory" => inventory }
  rescue JSON::ParserError => e
    raise Error, "invalid source filter: #{e.message}"
  end

  def verify_unsafe_links!(observed, filter, inventory: nil)
    if filter
      checked = load_filter!(filter)
      raise Error, "unsafe archive links differ from checked source filter" unless observed == checked["unsafe_links"]
      raise Error, "archive link inventory differs from checked source filter" if inventory && inventory != checked["archive_link_inventory"]
    else
      raise Error, "unsafe archive links require a checked source filter" unless observed.empty?
    end
  end

  def gnu_extension_value!(data, type)
    raise Error, "empty GNU #{type} record" if data.empty?

    value = data.sub(/(?:\0\n?|\n\0?)\z/, "")
    raise Error, "malformed GNU #{type} record" if value.empty? || value.include?("\0") || value.end_with?("\n")

    value
  end

  def pax_records!(data, type)
    records, offset = {}, 0
    while offset < data.bytesize
      separator = data.index(" ", offset)
      raise Error, "malformed PAX #{type} record length" unless separator

      length_text = data.byteslice(offset, separator - offset)
      raise Error, "malformed PAX #{type} record length" unless length_text.match?(/\A[1-9][0-9]*\z/)

      length = Integer(length_text, 10)
      record = data.byteslice(offset, length)
      raise Error, "truncated PAX #{type} record" unless record&.bytesize == length
      raise Error, "malformed PAX #{type} record" unless record.start_with?("#{length} ") && record.end_with?("\n")

      field = record.byteslice(length_text.bytesize + 1, length - length_text.bytesize - 2)
      key, value = field.split("=", 2)
      raise Error, "malformed PAX #{type} record" if key.nil? || key.empty? || value.nil? || key.include?("\0") || value.include?("\0")
      raise Error, "conflicting PAX #{type} record #{key}" if records.key?(key)

      records[key] = value
      offset += length
    end
    records
  end

  def effective_value!(kind, header_value, pax, gnu_value)
    values = [pax[kind], gnu_value].compact
    raise Error, "conflicting extended #{kind}" if values.uniq.length > 1

    values.first || header_value
  end

  def extract_gzip!(archive, destination, filter: nil)
    roots, seen, links, unsafe = Set.new, Set.new, [], []
    global_pax, per_entry_pax, gnu_path, gnu_linkpath = {}, nil, nil, nil
    Zlib::GzipReader.open(archive) do |gzip|
      Gem::Package::TarReader.new(gzip) do |tar|
        tar.each do |entry|
          typeflag = entry.header.typeflag
          case typeflag
          when "g"
            global_pax.merge!(pax_records!(entry.read, "global"))
            next
          when "x"
            raise Error, "conflicting per-entry PAX record" if per_entry_pax

            per_entry_pax = pax_records!(entry.read, "per-entry")
            next
          when "L"
            raise Error, "conflicting GNU long pathname record" if gnu_path

            gnu_path = gnu_extension_value!(entry.read, "long pathname")
            next
          when "K"
            raise Error, "conflicting GNU long link target record" if gnu_linkpath

            gnu_linkpath = gnu_extension_value!(entry.read, "long link target")
            next
          end

          pax = global_pax.merge(per_entry_pax || {})
          path = safe_path(effective_value!("path", entry.full_name, pax, gnu_path))
          linkname = effective_value!("linkpath", entry.header.linkname, pax, gnu_linkpath)
          per_entry_pax, gnu_path, gnu_linkpath = nil, nil, nil
          raise Error, "duplicate archive entry #{path}" unless seen.add?(path)

          roots << path.split("/", 2).first
          target = File.join(destination, path)
          if entry.directory?
            FileUtils.mkdir_p(target)
          elsif entry.file?
            FileUtils.mkdir_p(File.dirname(target))
            File.open(target, "wb", entry.header.mode & 0o777) { |file| IO.copy_stream(entry, file) }
          elsif entry.header.typeflag == "2" || entry.header.typeflag == "1"
            type = entry.header.typeflag == "2" ? :symlink : :hardlink
            mode = type == :symlink ? "120000" : format("%06o", 0o100000 | (entry.header.mode & 0o777))
            resolved, reason = link_target(type, path, linkname)
            record = link_record(type, path, linkname, mode)
            reason ? unsafe << record.merge("reason" => reason) : links << [type, path, linkname, resolved]
          else
            raise Error, "unsafe archive entry #{path}"
          end
        end
      end
    end
    raise Error, "dangling per-entry archive extension record" if per_entry_pax || gnu_path || gnu_linkpath
    raise Error, "source archive must contain exactly one root" unless roots.length == 1
    inventory = {
      "symlinks" => links.count { |type,| type == :symlink } + unsafe.count { |link| link["type"] == "symlink" },
      "hardlinks" => links.count { |type,| type == :hardlink } + unsafe.count { |link| link["type"] == "hardlink" },
      "safe_in_root_links" => links.length,
      "unsafe_links" => unsafe.length
    }
    verify_unsafe_links!(unsafe.sort_by { |link| [link["path"], link["type"], link["target"]] }, filter, inventory: inventory)

    links.select { |type,| type == :hardlink }.each do |_type, path, _linkname, resolved|
      source = File.join(destination, resolved)
      raise Error, "hardlink source is not a regular file: #{path}" unless File.file?(source) && !File.symlink?(source)

      target = File.join(destination, path)
      FileUtils.mkdir_p(File.dirname(target))
      File.link(source, target)
    end
    links.select { |type,| type == :symlink }.each do |_type, path, linkname, _resolved|
      target = File.join(destination, path)
      FileUtils.mkdir_p(File.dirname(target))
      File.symlink(linkname, target)
    end

    File.join(destination, roots.first).tap { |root| safe_tree!(root) }
  rescue Zlib::GzipFile::Error, Gem::Package::TarInvalidError => e
    raise Error, "cannot safely extract #{archive}: #{e.message}"
  end

  def sanitize_tree!(source, filter:)
    root, unsafe = File.basename(source), []
    Dir.glob(File.join(source, "**", "*"), File::FNM_DOTMATCH).sort.each do |path|
      next if %w[. ..].include?(File.basename(path)) || !File.lstat(path).symlink?

      relative, target = path.delete_prefix("#{source}/"), File.readlink(path)
      _resolved, reason = link_target(:symlink, File.join(root, relative), target)
      unsafe << link_record(:symlink, File.join(root, relative), target, "120000").merge("reason" => reason) if reason
    end
    verify_unsafe_links!(unsafe.sort_by { |link| [link["path"], link["type"], link["target"]] }, filter)
    unsafe.each { |link| FileUtils.rm_f(File.join(source, link.fetch("path").delete_prefix("#{root}/"))) }
    safe_tree!(source)
  end

  def prepare_source!(input, workdir, filter:)
    destination = File.join(workdir, "source")
    if File.file?(input)
      raise Error, "Source0 SHA-256 mismatch" unless sha256(input) == SOURCE_SHA256
      source = extract_gzip!(input, destination, filter: filter)
    elsif File.directory?(input)
      FileUtils.mkdir_p(destination)
      source = File.join(destination, "xberg-#{VERSION}")
      FileUtils.cp_r(input, source, preserve: true)
    else
      raise Error, "--source must name an archive or complete source directory"
    end
    source
  end

  def apply_patches!(source, patch_dir)
    %w[xberg-system-onnxruntime.patch xberg-fedora-onnxruntime-path.patch xberg-dynamic-tesseract.patch xberg-selected-workspace.patch xberg-fedora-system-tessdata.patch].each do |name|
      patch = File.join(patch_dir, name)
      raise Error, "missing tracked patch #{patch}" unless File.file?(patch)
      expected_sha256 = PATCH_SHA256[name]
      raise Error, "known patch SHA-256 mismatch: #{name}" if expected_sha256 && sha256(patch) != expected_sha256
      run!("patch", "--dry-run", "--fuzz=0", "-p1", "-i", patch, chdir: source)
      run!("patch", "--fuzz=0", "-p1", "-i", patch, chdir: source)
    end
  end

  def lock_packages(lock)
    if lock.lstrip.start_with?("{")
      data = JSON.parse(lock)
      return data.fetch("package").map do |item|
        fields = item.slice("name", "version", "source", "checksum")
        raise Error, "incomplete Cargo.lock record" unless fields["name"] && fields["version"]

        fields
      end
    end

    lock.split(/(?=^\[\[package\]\]$)/).filter_map do |block|
      next unless block.start_with?("[[package]]\n")
      fields = block.each_line.each_with_object({}) do |line, values|
        match = line.chomp.match(/\A(name|version|source|checksum) = "([^"]+)"\z/)
        values[match[1]] = match[2] if match
      end
      raise Error, "incomplete Cargo.lock record" unless fields["name"] && fields["version"]
      fields
    end
  end

  def registry_packages(lock)
    lock_packages(lock).select { |item| item["source"] == REGISTRY }.tap do |items|
      raise Error, "registry package lacks checksum" unless items.all? { |item| item["checksum"]&.match?(/\A[0-9a-f]{64}\z/) }
    end
  end

  def identity(item) = [item.fetch("name"), item.fetch("version")]

  def reject_forbidden!(items, context)
    forbidden = items.map { |item| identity(item) } & FORBIDDEN_IDENTITIES.to_a
    raise Error, "forbidden Intel identity in #{context}: #{forbidden.map { |name, version| "#{name} #{version}" }.join(', ')}" unless forbidden.empty?
  end

  def acquire!(item, cache, cargo_home)
    filename = "#{item.fetch('name')}-#{item.fetch('version')}.crate"
    path = File.join(cache, filename)
    unless File.file?(path)
      cached = Dir.glob(File.join(cargo_home, "registry", "cache", "*", filename)).find { |candidate| File.file?(candidate) }
      if cached
        FileUtils.cp(cached, path)
      else
        temporary = "#{path}.tmp-#{Process.pid}"
        run!("curl", "--fail", "--location", "--retry", "3", "--output", temporary, "https://static.crates.io/crates/#{item.fetch('name')}/#{filename}")
        File.rename(temporary, path)
      end
    end
    raise Error, "crate checksum mismatch: #{filename}" unless sha256(path) == item.fetch("checksum")
    path
  ensure
    FileUtils.rm_f(temporary) if defined?(temporary) && temporary
  end

  def cargo_checksum!(root, checksum)
    files = Dir.glob(File.join(root, "**", "*"), File::FNM_DOTMATCH).select { |path| File.file?(path) }.sort.to_h do |path|
      [path.delete_prefix("#{root}/"), sha256(path)]
    end
    File.write(File.join(root, ".cargo-checksum.json"), JSON.generate("files" => files, "package" => checksum) + "\n")
  end

  def materialize_vendor!(items, cargo_home, workdir, cache_input: nil)
    vendor, cache = File.join(workdir, "cargo-vendor"), (cache_input || File.join(workdir, "crates"))
    FileUtils.mkdir_p([vendor, cache])
    items.each do |item|
      destination = File.join(vendor, "#{item.fetch('name')}-#{item.fetch('version')}")
      next if File.directory?(destination)

      extract_gzip!(acquire!(item, cache, cargo_home), vendor)
      safe_tree!(destination)
      cargo_checksum!(destination, item.fetch("checksum"))
    end
    vendor
  end

  def cargo_home!(vendor, workdir)
    home = File.join(workdir, "cargo-home")
    FileUtils.mkdir_p(home)
    File.write(File.join(home, "config.toml"), <<~TOML)
      [source.crates-io]
      replace-with = "vendored-sources"
      [source.vendored-sources]
      directory = #{vendor.dump}
      [net]
      offline = true
    TOML
    home
  end

  def metadata!(source, home)
    JSON.parse(run!("cargo", "metadata", "--frozen", "--offline", "--format-version", "1", "--manifest-path", File.join(source, "crates/xberg-cli/Cargo.toml"), "--filter-platform", TARGET, *cargo_selection_args, env: { "CARGO_HOME" => home, "CARGO_NET_OFFLINE" => "true" }))
  end

  def metadata_result(source, home)
    output, error, status = Open3.capture3({ "CARGO_HOME" => home, "CARGO_NET_OFFLINE" => "true" }, "cargo", "metadata", "--frozen", "--offline", "--format-version", "1", "--manifest-path", File.join(source, "crates/xberg-cli/Cargo.toml"), "--filter-platform", TARGET, *cargo_selection_args)
    [output, error, status]
  end

  def cargo_tree!(source, home, edges)
    cli = File.join(source, "crates", "xberg-cli")
    run!("cargo", "tree", "--frozen", "--offline", "--target", TARGET, "--manifest-path", File.join(cli, "Cargo.toml"), "--package", "xberg-cli", *cargo_selection_args, "--edges", edges, "--no-dedupe", "--prefix", "none", "--format", "{p}", env: { "CARGO_HOME" => home, "CARGO_NET_OFFLINE" => "true" }).gsub(source, "SOURCE")
  end

  def tree_identities(output)
    output.each_line.filter_map { |line| line.match(/\A([A-Za-z0-9_-]+) v([^\s]+)/)&.captures }.uniq.sort
  end

  def identity_digest(identities)
    canonical = identities.uniq.sort
    raise Error, "graph identities are not sorted and unique" unless identities == canonical

    Digest::SHA256.hexdigest(canonical.map { |name, version| "#{name}\t#{version}\n" }.join)
  end

  def selected(metadata)
    packages = metadata.fetch("packages").to_h { |item| [item.fetch("id"), item] }
    nodes = metadata.fetch("resolve").fetch("nodes").to_h { |item| [item.fetch("id"), item] }
    root = metadata.fetch("resolve").fetch("root")
    roles, seen = Hash.new { |hash, key| hash[key] = Set.new }, Set.new
    visit = lambda do |id, role|
      return unless seen.add?([id, role])
      roles[id] << role
      nodes.fetch(id).fetch("deps").each do |dependency|
        dependency.fetch("dep_kinds").each do |kind|
          next unless [nil, "build", "dev"].include?(kind["kind"])
          visit.call(dependency.fetch("pkg"), kind["kind"] || role)
        end
      end
    end
    visit.call(root, "normal")
    roles.map do |id, kinds|
      package = packages.fetch(id)
      { "name" => package.fetch("name"), "version" => package.fetch("version"), "source" => package["source"], "roles" => kinds.to_a.sort }
    end.sort_by { |item| identity(item) }
  end

  def tree_receipt(root)
    digest, files, directories, symlinks, bytes = Digest::SHA256.new, 0, 0, 0, 0
    Dir.glob(File.join(root, "**", "*"), File::FNM_DOTMATCH).sort.each do |path|
      next if %w[. ..].include?(File.basename(path))
      relative, stat = path.delete_prefix("#{root}/"), File.lstat(path)
      mode = format("%04o", stat.mode & 0o777)
      if stat.directory?
        directories += 1
        digest.update(["directory", relative, mode].join("\0") + "\0")
      elsif stat.file?
        files += 1
        bytes += stat.size
        digest.update(["file", relative, mode, stat.size, sha256(path)].join("\0") + "\0")
      elsif stat.symlink?
        symlinks += 1
        target = File.readlink(path)
        raise Error, "vendor symlink escape #{relative}" if Pathname.new(target).absolute? || Pathname.new(File.join(File.dirname(relative), target)).cleanpath.to_s.start_with?("../")
        digest.update(["symlink", relative, mode, target].join("\0") + "\0")
      else
        raise Error, "unsafe vendor entry #{relative}"
      end
    end
    { "algorithm" => "sha256(sorted type,path,mode,link-target,size,content-sha256 records)", "sha256" => digest.hexdigest, "files" => files, "directories" => directories, "symlinks" => symlinks, "bytes" => bytes }
  end

  def license_inventory(items, vendor)
    entries = items.map do |item|
      root = File.join(vendor, "#{item.fetch('name')}-#{item.fetch('version')}")
      texts = Dir.glob(File.join(root, "**", "*"), File::FNM_DOTMATCH).select { |path| File.file?(path) && File.basename(path).match?(LICENSE) }.sort.map { |path| path.delete_prefix("#{root}/") }
      { "name" => item.fetch("name"), "version" => item.fetch("version"), "license_texts" => texts }
    end
    { "schema" => "agentlab-xberg-source-license-texts/v1", "method" => "source-level filename inventory; not final linked-license completeness", "packages" => entries, "counts" => { "present" => entries.count { |item| item["license_texts"].any? }, "absent" => entries.count { |item| item["license_texts"].empty? } }, "validation" => { "source_text_presence_verified" => true, "final_linked_license_complete" => false } }
  end

  def write_json(path, value) = File.write(path, JSON.pretty_generate(value) + "\n")

  def archive!(vendor, output)
    run!("tar", "--create", "--zstd", "--file", output, "--sort=name", "--mtime=@0", "--owner=0", "--group=0", "--numeric-owner", "--pax-option=delete=atime,delete=ctime", "--directory", File.dirname(vendor), File.basename(vendor))
  end

  def generate!(source_input:, closure_input:, lock_input:, workdir:, output_dir:, patch_dir:, filter:, cache_input: nil, prepared_vendor: nil, discover: false)
    raise Error, "--discover requires the checked Source0 archive" if discover && !File.file?(source_input)
    FileUtils.rm_rf(workdir)
    FileUtils.mkdir_p([workdir, output_dir])
    source = prepare_source!(source_input, workdir, filter: filter)
    apply_patches!(source, patch_dir)
    raise Error, "checked Cargo.lock is missing" unless File.file?(lock_input)
    raise Error, "checked Cargo.lock SHA-256 mismatch" unless sha256(lock_input) == LOCK_SHA256
    lock = File.join(source, "Cargo.lock")
    FileUtils.cp(lock_input, lock)
    lock_text = File.read(lock)
    lock_items = lock_packages(lock_text)
    lock_registry = registry_packages(lock_text)
    workspace_block = File.read(File.join(source, "Cargo.toml")).match(/\[workspace\].*?members\s*=\s*\[(.*?)\]/m)&.captures&.first
    raise Error, "workspace members are missing" unless workspace_block
    workspace_names = workspace_block.scan(/"([^"]+)"/).map { |member| File.basename(member.first) }
    lock_workspace = lock_items.reject { |item| item["source"] }.select { |item| workspace_names.include?(item.fetch("name")) }
    lock_git = lock_items.select { |item| item["source"].to_s.start_with?("git+") }
    raise Error, "checked lock must contain six workspace identities" unless lock_workspace.length == 6
    raise Error, "checked lock must contain zero Git identities" unless lock_git.empty?
    reject_forbidden!(lock_registry, "checked Cargo.lock")
    lock_by_identity = lock_registry.to_h { |item| [identity(item), item] }
    tracked_items = unless discover
      raise Error, "tracked closure is missing" unless closure_input && File.file?(closure_input)
      tracked_closure = JSON.parse(File.read(closure_input))
      raise Error, "tracked closure schema mismatch" unless tracked_closure["schema"] == "agentlab-xberg-cargo-closure/v2"
      raise Error, "tracked closure release mismatch" unless tracked_closure.dig("release", "name") == NAME && tracked_closure.dig("release", "version") == VERSION
      values = tracked_closure.dig("selection", "registry_identities")
      raise Error, "tracked closure selection is missing" unless values.is_a?(Array)
      reject_forbidden!(values, "tracked selection")
      raise Error, "tracked closure identities are not sorted and unique" unless values.map { |item| identity(item) } == values.map { |item| identity(item) }.uniq.sort
      values
    end
    cache_home = ENV["CARGO_HOME"] || File.join(workdir, "crate-cache")
    FileUtils.mkdir_p(cache_home)
    vendor_items = lock_registry.sort_by { |item| identity(item) }
    FileUtils.rm_rf(File.join(workdir, "cargo-vendor"))
    vendor = if prepared_vendor
      File.expand_path(prepared_vendor)
    else
      materialize_vendor!(vendor_items, cache_home, workdir, cache_input: cache_input && File.expand_path(cache_input))
    end
    raise Error, "prepared vendor directory is missing" unless File.directory?(vendor)
    home = cargo_home!(vendor, workdir)
    metadata = metadata!(source, home)
    raise Error, "directory-source replacement was not configured" unless File.read(File.join(home, "config.toml")).include?(vendor)
    raise Error, "Git dependency found" unless metadata.fetch("packages").none? { |item| item["source"].to_s.start_with?("git+") }
    metadata_registry = metadata.fetch("packages").select { |item| item["source"] == REGISTRY }
    reject_forbidden!(metadata_registry, "Cargo metadata")
    unknown_metadata = metadata_registry.map { |item| identity(item) } - lock_by_identity.keys
    raise Error, "Cargo registry identity absent from checked lock/closure: #{unknown_metadata.map { |name, version| "#{name} #{version}" }.join(', ')}" unless unknown_metadata.empty?
    normal_tree = cargo_tree!(source, home, "normal")
    all_tree = cargo_tree!(source, home, "normal,build,dev")
    normal_graph = tree_identities(normal_tree)
    all_graph = tree_identities(all_tree)
    selected_registry = normal_graph.filter { |item| lock_by_identity.key?(item) }
    items = selected_registry.map { |item| lock_by_identity.fetch(item) }.sort_by { |item| identity(item) }
    if tracked_items
      tracked = tracked_items.map do |item|
        locked = lock_by_identity.fetch(identity(item)) { raise Error, "tracked closure identity is absent from Cargo.lock: #{identity(item).join(' ')}" }
        raise Error, "tracked closure record differs from Cargo.lock: #{identity(item).join(' ')}" unless locked == item
        item
      end
      raise Error, "tracked closure differs from the offline selected graph" unless selected_registry == tracked.map { |item| identity(item) }
    end
    resolver_only = vendor_items.reject { |item| items.any? { |selected| identity(selected) == identity(item) } }
    raise Error, "selected registry identity count mismatch" unless items.length == SELECTED_REGISTRY
    raise Error, "vendor registry identity count mismatch" unless vendor_items.length == VENDOR_REGISTRY
    raise Error, "resolver-only registry identity count mismatch" unless resolver_only.length == RESOLVER_ONLY_REGISTRY
    raise Error, "normal graph package count mismatch" unless normal_graph.length == NORMAL_PACKAGES
    raise Error, "normal/build/dev graph package count mismatch" unless all_graph.length == NORMAL_BUILD_DEV_PACKAGES
    raise Error, "normal graph identity mismatch" unless identity_digest(normal_graph) == NORMAL_IDENTITY_SHA256
    raise Error, "normal/build/dev graph identity mismatch" unless identity_digest(all_graph) == NORMAL_BUILD_DEV_IDENTITY_SHA256
    tree = tree_receipt(vendor)
    manifest = vendor_items.map { |item| "#{item.fetch('name')} #{item.fetch('version')}" }.join("\n") + "\n"
    selection = "--no-default-features --features #{CLI_FEATURES_ARGUMENT}"
    closure = { "schema" => "agentlab-xberg-cargo-closure/v2", "release" => { "name" => NAME, "version" => VERSION, "cargo_lock_sha256" => LOCK_SHA256 }, "selection" => { "package" => "xberg-cli", "target" => TARGET, "features" => CLI_FEATURES, "no_default_features" => true, "registry_identities" => items }, "resolver_model" => { "kind" => "selected-Fedora-workspace-lock-complete", "rationale" => "The checked six-member Fedora workspace lock is complete for Cargo resolution; all locked registry identities are vendored while the selected CLI closure remains explicit." }, "vendor_registry_identities" => vendor_items, "resolver_only_registry_identities" => resolver_only, "counts" => { "selected_registry_identities" => items.length, "vendor_registry_identities" => vendor_items.length, "resolver_only_registry_identities" => resolver_only.length, "normal_packages" => normal_graph.length, "normal_build_dev_packages" => all_graph.length, "root_lock_registry" => lock_registry.length, "root_lock_workspace" => lock_workspace.length, "git_dependencies" => lock_git.length }, "commands" => { "generation_lock" => "--lock PATH (checked SHA-256 #{LOCK_SHA256})", "metadata" => "cargo metadata --frozen --offline --filter-platform #{TARGET} #{selection}", "tree_normal" => "cargo tree --frozen --offline --target #{TARGET} --package xberg-cli #{selection} --edges normal", "tree_all" => "cargo tree --frozen --offline --target #{TARGET} --package xberg-cli #{selection} --edges normal,build,dev" }, "outputs" => { "identity_serialization" => IDENTITY_SERIALIZATION, "normal_identity_sha256" => identity_digest(normal_graph), "normal_build_dev_identity_sha256" => identity_digest(all_graph) }, "validation" => { "lock_checksums_verified" => true, "archive_paths_and_symlink_escapes_rejected" => true, "offline_frozen_package_metadata_and_tree_verified" => true, "git_dependencies_zero" => true, "forbidden_intel_identities_rejected" => true, "registry_identities_bound_to_checked_lock_and_closure" => true, "final_linked_license_complete" => false } }
    closure["resolver_model"]["rationale"] = "The checked six-member Fedora workspace lock is complete for Cargo resolution; all locked registry identities are vendored while the selected CLI closure remains explicit."
    license = license_inventory(vendor_items, vendor)
    receipt = { "schema" => "agentlab-xberg-cargo-vendor/v1", "release" => closure.fetch("release"), "vendor_archive" => { "name" => "#{NAME}-#{VERSION}-cargo-vendor.tar.zst", "root" => "cargo-vendor" }, "vendor_tree" => tree, "inputs" => { "cargo_closure_sha256" => nil, "license_text_presence_sha256" => nil }, "root_lock" => { "registry" => lock_registry.length, "workspace" => lock_workspace.length, "git" => lock_git.length }, "graph" => { "normal" => normal_graph.length, "normal_build_dev" => all_graph.length, "ort_download_delta" => nil }, "validation" => closure.fetch("validation") }
    File.write(File.join(output_dir, "#{NAME}-#{VERSION}-cargo-vendor.txt"), manifest)
    write_json(File.join(output_dir, "#{NAME}-#{VERSION}-cargo-closure.json"), closure)
    write_json(File.join(output_dir, "#{NAME}-#{VERSION}-license-text-presence.json"), license)
    receipt["inputs"]["cargo_closure_sha256"] = sha256(File.join(output_dir, "#{NAME}-#{VERSION}-cargo-closure.json"))
    receipt["inputs"]["license_text_presence_sha256"] = sha256(File.join(output_dir, "#{NAME}-#{VERSION}-license-text-presence.json"))
    write_json(File.join(output_dir, "#{NAME}-#{VERSION}-cargo-vendor-receipt.json"), receipt)
    archive!(vendor, File.join(output_dir, "#{NAME}-#{VERSION}-cargo-vendor.tar.zst"))
  end

  def verify!(vendor:, receipt:)
    expected = JSON.parse(File.read(receipt)).fetch("vendor_tree")
    actual = tree_receipt(vendor)
    raise Error, "vendor tree identity mismatch" unless actual == expected
    raise Error, "vendor tree must have no symlinks" unless actual.fetch("symlinks").zero?
  end
end

if $PROGRAM_NAME == __FILE__
options = {}
OptionParser.new do |parser|
  parser.on("--source PATH") { |value| options[:source] = value }
  parser.on("--closure PATH") { |value| options[:closure] = value }
  parser.on("--lock PATH") { |value| options[:lock] = value }
  parser.on("--workdir PATH") { |value| options[:workdir] = value }
  parser.on("--output-dir PATH") { |value| options[:output_dir] = value }
  parser.on("--patch-dir PATH") { |value| options[:patch_dir] = value }
  parser.on("--filter PATH") { |value| options[:filter] = value }
  parser.on("--cache PATH") { |value| options[:cache] = value }
  parser.on("--prepared-vendor PATH") { |value| options[:prepared_vendor] = value }
  parser.on("--discover") { options[:discover] = true }
  parser.on("--sanitize-only") { options[:sanitize_only] = true }
  parser.on("--verify") { options[:verify] = true }
  parser.on("--vendor-dir PATH") { |value| options[:vendor_dir] = value }
  parser.on("--receipt PATH") { |value| options[:receipt] = value }
end.parse!
if options[:sanitize_only]
  abort("error: --source and --filter are required for --sanitize-only") unless options.values_at(:source, :filter).all?
  source = File.expand_path(options[:source])
  abort("error: --source must name an extracted source directory") unless File.directory?(source)
  XbergCargoClosure.sanitize_tree!(source, filter: File.expand_path(options[:filter]))
elsif options[:verify]
  abort("error: --vendor-dir and --receipt are required") unless options.values_at(:vendor_dir, :receipt).all?
  XbergCargoClosure.verify!(vendor: File.expand_path(options[:vendor_dir]), receipt: File.expand_path(options[:receipt]))
else
  required = options.values_at(:source, :lock, :workdir, :output_dir, :filter).all?
  abort("error: --source, --lock, --workdir, --output-dir, and --filter are required") unless required
  abort("error: --closure is required unless --discover is used") unless options[:discover] || options[:closure]
  abort("error: --discover cannot be combined with --closure") if options[:discover] && options[:closure]
  abort("error: workdir must be below /srv/tmp") unless File.expand_path(options[:workdir]).start_with?("/srv/tmp/")
  abort("error: discovery output must be below /srv/tmp") if options[:discover] && !File.expand_path(options[:output_dir]).start_with?("/srv/tmp/")
  default_patches = File.expand_path("../packages/xberg", __dir__)
  XbergCargoClosure.generate!(source_input: File.expand_path(options[:source]), closure_input: options[:closure] && File.expand_path(options[:closure]), lock_input: File.expand_path(options[:lock]), workdir: File.expand_path(options[:workdir]), output_dir: File.expand_path(options[:output_dir]), patch_dir: File.expand_path(options[:patch_dir] || default_patches), filter: File.expand_path(options[:filter]), cache_input: options[:cache] && File.expand_path(options[:cache]), prepared_vendor: options[:prepared_vendor] && File.expand_path(options[:prepared_vendor]), discover: options[:discover])
end
end
