#!/usr/bin/env ruby
# frozen_string_literal: true

require "digest"
require "base64"
require "json"
require "open3"
require "optparse"
require "rubygems/package"
require "set"
require "yaml"
require "zlib"

module OpenCodeUpstreamReleaseAudit
  module_function

  RELEASE_SENSITIVE_PATHS = [
    "bun.lock",
    "package.json",
    "packages/opencode/package.json",
  ].freeze
  DEFAULT_ARCHIVE_LIMITS = {
    archive_bytes: 128 * 1024 * 1024,
    members: 50_000,
    member_bytes: 32 * 1024 * 1024,
    total_bytes: 512 * 1024 * 1024,
    path_bytes: 4096,
  }.freeze
  MCP_DEPENDENCIES = [
    "@modelcontextprotocol/client",
    "@modelcontextprotocol/server",
    "@modelcontextprotocol/sdk",
  ].freeze
  RECEIPT_SCHEMA = "agentlab-opencode-upstream-release-audit/v5"
  RECEIPT_RELATIVE_PATH = "evidence/opencode/upstream-release-audit.json"
  WITNESS_SCHEMA = "agentlab-opencode-upstream-release-witness/v1"
  WITNESS_RELATIVE_PATH = "evidence/opencode/upstream-release-witness.json"
  WITNESS_SHA256 = "f873723f7c0ff2496f3e7fd947abf402ee86ba66c1ced93b10452ad169fc74ee"

  def git(repo, *arguments)
    git_output(repo, *arguments).strip
  end

  def git_output(repo, *arguments)
    output, error, status = Open3.capture3("git", "-C", repo, *arguments, binmode: true)
    raise "git #{arguments.join(' ')} failed: #{error.strip}" unless status.success?

    output
  end

  def git_tree(repo, commit)
    object_format = git(repo, "rev-parse", "--show-object-format")
    raise "unsupported Git object format #{object_format}" unless object_format == "sha1"

    git_output(repo, "ls-tree", "-rz", "--full-tree", commit).split("\0").reject(&:empty?).to_h do |record|
      metadata, path = record.split("\t", 2)
      mode, type, object_id = metadata.split(" ", 3)
      raise "unsupported Git tree entry #{type} at #{path}" unless type == "blob"

      [path, { "mode" => mode, "object_id" => object_id }]
    end
  end

  def git_file(repo, revision, path)
    git_output(repo, "show", "#{revision}:#{path}")
  end

  def default_witness_path
    File.expand_path("../#{WITNESS_RELATIVE_PATH}", __dir__)
  end

  def load_witness(path, expected_sha256)
    content = File.binread(path)
    actual_sha256 = Digest::SHA256.hexdigest(content)
    raise "OpenCode release witness SHA-256 mismatch" unless actual_sha256 == expected_sha256

    witness = JSON.parse(content)
    raise "unsupported OpenCode release witness schema" unless witness["schema"] == WITNESS_SCHEMA

    witness
  end

  def package_requirement(repo, revision, package)
    manifest = JSON.parse(git_file(repo, revision, "packages/opencode/package.json"))
    requirements = %w[dependencies devDependencies].filter_map do |group|
      manifest.fetch(group, {})[package]
    end.uniq
    raise "conflicting #{package} requirements in #{revision}" if requirements.length > 1

    requirements.first
  end

  def npm_source(identity, integrity)
    name, version = identity.match(/\A(?<name>@[^@]+|[^@]+)@(?<version>[^@]+)\z/)&.captures
    raise "invalid npm lock identity #{identity}" unless name && version
    encoded = integrity.delete_prefix("sha512-")
    raise "invalid npm SHA-512 integrity #{integrity}" if encoded == integrity

    digest = Base64.strict_decode64(encoded)
    raise "invalid npm SHA-512 digest length for #{identity}" unless digest.bytesize == 64

    basename = name.split("/").last
    {
      "identity" => identity,
      "integrity" => integrity,
      "source_url" => "https://registry.npmjs.org/#{name}/-/#{basename}-#{version}.tgz",
    }
  rescue ArgumentError
    raise "invalid npm SHA-512 integrity #{integrity}"
  end

  def valid_npm_source?(package, requirement, source)
    return false unless source.is_a?(Hash)
    return false unless source["identity"].is_a?(String) && source["integrity"].is_a?(String)

    expected_identity = "#{package}@#{requirement}"
    npm_source(source["identity"], source["integrity"]) == source &&
      source["identity"] == expected_identity
  rescue RuntimeError
    false
  end

  def lock_source(repo, revision, package)
    matches = []
    packages_map = false
    packages_map_seen = false
    git_file(repo, revision, "bun.lock").lines.each do |line|
      if line.match?(/^  "packages": \{\s*$/)
        raise "duplicate Bun packages map in #{revision}" if packages_map_seen

        packages_map = true
        packages_map_seen = true
        next
      elsif packages_map && line.match?(/^  \},?\s*$/)
        packages_map = false
        next
      end
      next unless packages_map
      next unless line.match?(/^    "#{Regexp.escape(package)}":/)

      match = line.match(/^    "#{Regexp.escape(package)}": \["(?<identity>[^"]+)".*"(?<integrity>sha512-[A-Za-z0-9+\/=]+)"\],?\s*$/)
      raise "malformed Bun packages map record for #{package} in #{revision}" unless match

      matches << npm_source(match[:identity], match[:integrity])
    end
    raise "Bun lock is missing packages map in #{revision}" unless packages_map_seen
    raise "duplicate root lock records for #{package} in #{revision}" if matches.length > 1

    matches.first
  end

  def mcp_dependency_transition(repo, packaged_tag, latest_tag)
    MCP_DEPENDENCIES.map do |package|
      packaged_requirement = package_requirement(repo, packaged_tag, package)
      latest_requirement = package_requirement(repo, latest_tag, package)
      packaged_source = lock_source(repo, packaged_tag, package) if packaged_requirement
      latest_source = lock_source(repo, latest_tag, package) if latest_requirement
      if (packaged_requirement && !packaged_source) || (latest_requirement && !latest_source)
        raise "missing root lock source for #{package} dependency transition"
      end
      if packaged_source && packaged_source.fetch("identity") != "#{package}@#{packaged_requirement}"
        raise "Bun lock identity does not match #{package} requirement in #{packaged_tag}"
      end
      if latest_source && latest_source.fetch("identity") != "#{package}@#{latest_requirement}"
        raise "Bun lock identity does not match #{package} requirement in #{latest_tag}"
      end

      {
        "package" => package,
        "packaged_requirement" => packaged_requirement,
        "latest_requirement" => latest_requirement,
        "packaged_source" => packaged_source,
        "latest_source" => latest_source,
      }
    end
  end

  def safe_archive_path(name, expected_root, path_limit)
    normalized = name.end_with?("/") ? name.delete_suffix("/") : name
    raise "archive member path is empty" if normalized.empty?
    raise "archive member path exceeds limit" if normalized.bytesize > path_limit
    raise "archive member path is not portable: #{name}" if normalized.start_with?("/") || normalized.include?("\\")

    segments = normalized.split("/", -1)
    if segments.any? { |segment| segment.empty? || segment == "." || segment == ".." }
      raise "archive member path is unsafe: #{name}"
    end
    unless normalized == expected_root || normalized.start_with?("#{expected_root}/")
      raise "archive member is outside exact root #{expected_root}: #{name}"
    end

    normalized
  end

  def git_blob_id(content)
    Digest::SHA1.hexdigest("blob #{content.bytesize}\0#{content}")
  end

  def archive_tree(archive, expected_root, expected_commit: nil, limits: DEFAULT_ARCHIVE_LIMITS)
    limits = DEFAULT_ARCHIVE_LIMITS.merge(limits)
    raise "archive exceeds compressed size limit" if File.size(archive) > limits.fetch(:archive_bytes)

    seen = Set.new
    blobs = {}
    manifest = nil
    root_seen = false
    members = 0
    total_bytes = 0
    pax_commit = nil

    Zlib::GzipReader.open(archive) do |gzip|
      Gem::Package::TarReader.new(gzip) do |tar|
        tar.each do |entry|
          members += 1
          raise "archive exceeds member count limit" if members > limits.fetch(:members)

          if entry.full_name == "pax_global_header"
            raise "archive PAX identity header must be first" unless members == 1
            raise "archive PAX identity header has wrong type" unless entry.header.typeflag == "g"
            raise "archive contains duplicate PAX identity header" if pax_commit
            raise "archive PAX identity header exceeds size limit" if entry.header.size > limits.fetch(:member_bytes)

            total_bytes += entry.header.size
            raise "archive exceeds expanded size limit" if total_bytes > limits.fetch(:total_bytes)

            content = entry.read
            match = content.match(/\A(?<length>\d+) comment=(?<commit>[0-9a-f]{40})\n\z/)
            unless match && match[:length].to_i == content.bytesize
              raise "archive PAX identity header is malformed"
            end

            pax_commit = match[:commit]
            next
          end

          name = safe_archive_path(entry.full_name, expected_root, limits.fetch(:path_bytes))
          raise "archive contains duplicate member #{name}" unless seen.add?(name)

          if name == expected_root
            raise "archive root must be a directory" unless entry.directory?
            raise "archive root directory has payload" unless entry.header.size.zero?

            root_seen = true
            next
          end

          relative_path = name.delete_prefix("#{expected_root}/")
          if entry.directory?
            raise "archive directory has payload: #{relative_path}" unless entry.header.size.zero?

            next
          elsif entry.file?
            size = entry.header.size
            raise "archive member exceeds size limit: #{relative_path}" if size > limits.fetch(:member_bytes)

            total_bytes += size
            raise "archive exceeds expanded size limit" if total_bytes > limits.fetch(:total_bytes)

            content = entry.read
            raise "archive member size changed while reading: #{relative_path}" unless content.bytesize == size

            mode = entry.header.mode & 0o111 == 0 ? "100644" : "100755"
            blobs[relative_path] = { "mode" => mode, "object_id" => git_blob_id(content) }
            manifest = content if relative_path == "packages/opencode/package.json"
          elsif entry.header.typeflag == "2"
            raise "archive symlink has payload: #{relative_path}" unless entry.header.size.zero?

            content = entry.header.linkname.to_s.b
            raise "archive symlink target exceeds size limit: #{relative_path}" if content.bytesize > limits.fetch(:member_bytes)

            total_bytes += content.bytesize
            raise "archive exceeds expanded size limit" if total_bytes > limits.fetch(:total_bytes)

            blobs[relative_path] = { "mode" => "120000", "object_id" => git_blob_id(content) }
          else
            raise "archive contains unsupported member type at #{relative_path}"
          end
        end
      end
    end

    raise "archive is missing exact root directory #{expected_root}" unless root_seen
    raise "archive is missing packages/opencode/package.json" unless manifest
    if expected_commit && pax_commit != expected_commit
      raise "archive PAX identity does not match resolved release commit"
    end

    { blobs: blobs, manifest: manifest }
  rescue Zlib::GzipFile::Error, Gem::Package::TarInvalidError => error
    raise "invalid release archive: #{error.message}"
  end

  def verify_archive_identity(archive, repo, latest_commit, expected_root, limits: DEFAULT_ARCHIVE_LIMITS)
    actual = archive_tree(archive, expected_root, expected_commit: latest_commit, limits: limits)
    expected = git_tree(repo, latest_commit)
    missing = expected.keys - actual.fetch(:blobs).keys
    extra = actual.fetch(:blobs).keys - expected.keys
    mismatched = (expected.keys & actual.fetch(:blobs).keys).select do |path|
      expected.fetch(path) != actual.fetch(:blobs).fetch(path)
    end
    unless missing.empty? && extra.empty? && mismatched.empty?
      details = []
      details << "missing=#{missing.first(3).join(',')}" unless missing.empty?
      details << "extra=#{extra.first(3).join(',')}" unless extra.empty?
      details << "mismatched=#{mismatched.first(3).join(',')}" unless mismatched.empty?
      raise "archive tree does not match resolved release commit: #{details.join(' ')}"
    end

    actual.fetch(:manifest)
  end

  def safe_patch_path(path)
    segments = path.split("/", -1)
    if path.empty? || path.start_with?("/") || path.include?("\\") || path.include?("%") ||
       segments.any? { |segment| segment.empty? || segment == "." || segment == ".." }
      raise "unsafe or non-literal packaging patch path #{path}"
    end

    path
  end

  def packaging_patch_inputs(package_spec, content: nil)
    content ||= File.binread(package_spec)
    declarations = content.lines.each_with_index.filter_map do |line, index|
      match = line.match(/^Patch(?<number>\d*):\s+(?<path>\S+)\s*$/)
      next unless match

      number = match[:number].empty? ? "0" : match[:number]
      { "number" => number, "path" => safe_patch_path(match[:path]), "line" => index + 1 }
    end
    raise "OpenCode spec declares no packaging patches" if declarations.empty?
    raise "OpenCode spec has duplicate Patch numbers" unless declarations.map { |item| item.fetch("number") }.uniq.length == declarations.length

    applications = Hash.new { |hash, key| hash[key] = [] }
    content.lines.each_with_index do |line, index|
      match = line.match(/^patch\s+(?<arguments>.*?)<\s*%\{PATCH(?<number>\d*)\}\s*$/)
      next unless match

      number = match[:number].empty? ? "0" : match[:number]
      workdir = match[:arguments].match(/(?:^|\s)-d\s+(\S+)/)&.captures&.first
      applications[number] << {
        "line" => index + 1,
        "root" => workdir || "Source0",
      }
    end

    spec_directory = File.dirname(package_spec)
    patches = declarations.map do |declaration|
      path = File.join(spec_directory, declaration.fetch("path"))
      raise "declared packaging patch is missing: #{declaration.fetch('path')}" unless File.file?(path)

      patch_applications = applications.fetch(declaration.fetch("number"), [])
      raise "declared packaging patch is not applied: Patch#{declaration.fetch('number')}" if patch_applications.empty?

      declaration.merge(
        "sha256" => Digest::SHA256.file(path).hexdigest,
        "applications" => patch_applications,
      )
    end

    {
      "spec" => File.basename(package_spec),
      "spec_sha256" => Digest::SHA256.hexdigest(content),
      "patches" => patches,
      "source0_revalidation_required" => patches.any? do |patch|
        patch.fetch("applications").any? { |application| application.fetch("root") == "Source0" }
      end,
    }
  end

  def reproduction(upstream, latest_version)
    repository = upstream.fetch("repository")
    tag = "#{upstream.fetch('tag_prefix')}#{latest_version}"
    repository_path = "/srv/tmp/agentlab-opencode-upstream"
    archive_path = "/srv/tmp/opencode-#{tag}.tar.gz"
    generated_receipt_path = "/srv/tmp/opencode-#{tag}-release-audit.json"
    archive_url = upstream.fetch("source_url_template").gsub("{version}", latest_version)

    {
      "repository_url" => "https://github.com/#{repository}.git",
      "archive_url" => archive_url,
      "repository_path" => repository_path,
      "archive_path" => archive_path,
      "generated_receipt_path" => generated_receipt_path,
      "receipt_path" => RECEIPT_RELATIVE_PATH,
      "steps" => [
        "git clone --mirror https://github.com/#{repository}.git #{repository_path}",
        "curl --fail --location --output #{archive_path} #{archive_url}",
        "scripts/audit-opencode-upstream-release --repo #{repository_path} --archive #{archive_path} --latest-version #{latest_version} > #{generated_receipt_path}",
        "cmp --silent #{generated_receipt_path} #{RECEIPT_RELATIVE_PATH}",
      ],
    }
  end

  def receipt_errors(package_manifest:, package_spec:, receipt:, witness_path: default_witness_path, expected_witness_sha256: WITNESS_SHA256)
    package = YAML.safe_load_file(package_manifest, aliases: false)
    upstream = package.fetch("upstream")
    data = receipt.is_a?(Hash) ? receipt : JSON.parse(File.read(receipt))
    current_version = upstream.fetch("current_version").to_s
    packaged = data.fetch("packaged_release")
    latest = data.fetch("latest_release")
    witness = load_witness(witness_path, expected_witness_sha256)
    errors = []
    packaged_version = packaged.fetch("version").to_s
    latest_version = latest.fetch("version").to_s
    tag_prefix = upstream.fetch("tag_prefix")

    errors << "unsupported receipt schema" unless data["schema"] == RECEIPT_SCHEMA
    errors << "receipt package mismatch" unless data["package"] == "opencode"
    errors << "receipt immutable witness mismatch" unless data["immutable_witness"] == {
      "path" => WITNESS_RELATIVE_PATH,
      "sha256" => expected_witness_sha256,
    }
    errors << "receipt reproduction contract mismatch" unless data["reproduction"] == reproduction(upstream, latest_version)
    errors << "receipt packaged tag is inconsistent" unless packaged["tag"] == "#{tag_prefix}#{packaged_version}"
    errors << "receipt latest tag is inconsistent" unless latest["tag"] == "#{tag_prefix}#{latest_version}"
    errors << "receipt latest archive root is inconsistent" unless latest["archive_root"] == "opencode-#{latest_version}"
    errors << "receipt packaged commit is invalid" unless packaged["commit"].to_s.match?(/\A[0-9a-f]{40}\z/)
    errors << "receipt latest commit is invalid" unless latest["commit"].to_s.match?(/\A[0-9a-f]{40}\z/)
    errors << "receipt packaged archive SHA-256 is invalid" unless packaged["archive_sha256"].to_s.match?(/\A[0-9a-f]{64}\z/)
    errors << "receipt latest archive SHA-256 is invalid" unless latest["archive_sha256"].to_s.match?(/\A[0-9a-f]{64}\z/)
    errors << "receipt latest release is not newer than packaged release" unless Gem::Version.new(latest_version) > Gem::Version.new(packaged_version)
    errors << "receipt does not preserve blocked package state" unless
      data.dig("package_state", "status") == "blocked" &&
      data.dig("package_state", "copr_enabled") == false &&
      data.dig("package_state", "blocked_state_preserved") == true
    errors << "package must remain blocked" unless package["status"] == "blocked"
    errors << "package COPR must remain disabled" unless package.dig("copr", "enabled") == false
    errors << "receipt does not require selected-source evidence refresh" unless data.dig("delta", "selected_source_evidence_refresh_required") == true
    errors << "receipt does not require downstream patch revalidation" unless data.dig("delta", "downstream_patch_revalidation_required") == true
    sensitive_paths = data.dig("delta", "release_sensitive_paths")
    transition = data.dig("delta", "mcp_dependency_transition")
    errors << "receipt MCP dependency source mapping is incomplete" unless
      transition.is_a?(Array) &&
      transition.map { |entry| entry["package"] } == MCP_DEPENDENCIES &&
      transition.all? do |entry|
        %w[packaged latest].all? do |release|
          requirement = entry["#{release}_requirement"]
          source = entry["#{release}_source"]
          if requirement
            valid_npm_source?(entry.fetch("package"), requirement, source)
          else
            source.nil?
          end
        end
      end
    errors << "receipt MCP dependency transition does not match immutable witness" unless
      transition == witness["mcp_dependency_transition"]
    sensitive_blobs = data.dig("delta", "release_sensitive_blobs")
    errors << "receipt release-sensitive blob mapping is incomplete" unless
      sensitive_blobs.is_a?(Hash) &&
      sensitive_blobs.keys.sort == RELEASE_SENSITIVE_PATHS.sort &&
      sensitive_blobs.all? do |path, blobs|
        blobs.is_a?(Hash) &&
          blobs.keys.sort == %w[latest packaged] &&
          blobs.values.all? { |object_id| object_id.to_s.match?(/\A[0-9a-f]{40}\z/) } &&
          sensitive_paths[path] == (blobs["packaged"] != blobs["latest"])
      end
    expected_blobs = RELEASE_SENSITIVE_PATHS.to_h do |path|
      [path, {
        "packaged" => witness.dig("releases", "packaged", "release_sensitive_blobs", path),
        "latest" => witness.dig("releases", "latest", "release_sensitive_blobs", path),
      }]
    end
    errors << "receipt release-sensitive blobs do not match immutable witness" unless sensitive_blobs == expected_blobs
    errors << "receipt releases do not match immutable witness" unless
      %w[packaged latest].all? do |release|
        receipt_release = release == "packaged" ? packaged : latest
        witness_release = witness.dig("releases", release)
        %w[version tag commit].all? { |field| receipt_release[field] == witness_release[field] }
      end
    errors << "receipt latest archive is not tree-verified" unless latest["archive_matches_commit_tree"] == true
    errors << "receipt changed-path count is invalid" unless data.dig("delta", "changed_paths").is_a?(Integer) && data.dig("delta", "changed_paths").positive?
    errors << "receipt release-sensitive path audit is incomplete" unless
      sensitive_paths.is_a?(Hash) &&
      sensitive_paths.keys.sort == RELEASE_SENSITIVE_PATHS.sort &&
      sensitive_paths.values.all? { |changed| changed == true || changed == false }

    if current_version == packaged_version
      errors << "receipt packaged tag mismatch" unless packaged["tag"] == upstream["source_tag"]
      errors << "receipt packaged commit mismatch" unless packaged["commit"] == upstream["source_commit"]
      errors << "receipt packaged archive SHA-256 mismatch" unless packaged["archive_sha256"] == upstream["source_sha256"]
    elsif current_version == latest_version
      errors << "receipt latest tag mismatch" unless latest["tag"] == upstream["source_tag"]
      errors << "receipt latest commit mismatch" unless latest["commit"] == upstream["source_commit"]
      errors << "receipt latest archive SHA-256 mismatch" unless latest["archive_sha256"] == upstream["source_sha256"]
    else
      errors << "receipt does not cover packaged version #{current_version}"
    end

    actual_patches = packaging_patch_inputs(package_spec)
    recorded_patches = data.fetch("packaging_patch_inputs")
    errors << "receipt packaging patch inputs mismatch" unless recorded_patches == actual_patches

    errors
  rescue JSON::ParserError, KeyError, Psych::SyntaxError, ArgumentError, RuntimeError, Errno::ENOENT => error
    ["invalid receipt: #{error.message}"]
  end

  def audit(package_manifest:, repo:, archive:, latest_version:, package_spec: nil, archive_limits: DEFAULT_ARCHIVE_LIMITS,
            witness_path: default_witness_path, expected_witness_sha256: WITNESS_SHA256)
    package = YAML.safe_load_file(package_manifest, aliases: false)
    upstream = package.fetch("upstream")
    packaged_version = upstream.fetch("current_version").to_s
    packaged_tag = upstream.fetch("source_tag")
    packaged_commit = upstream.fetch("source_commit")
    latest_tag = "#{upstream.fetch('tag_prefix')}#{latest_version}"
    package_spec ||= File.join(File.dirname(package_manifest), "opencode.spec")
    witness = load_witness(witness_path, expected_witness_sha256)

    raise "OpenCode package must remain blocked" unless package.fetch("status") == "blocked"
    raise "OpenCode COPR package must remain disabled" unless package.dig("copr", "enabled") == false
    raise "latest release must be newer than packaged release" unless Gem::Version.new(latest_version) > Gem::Version.new(packaged_version)

    actual_packaged_commit = git(repo, "rev-parse", "#{packaged_tag}^{commit}")
    raise "packaged tag commit does not match package.yml" unless actual_packaged_commit == packaged_commit

    latest_commit = git(repo, "rev-parse", "#{latest_tag}^{commit}")
    unless witness["repository"] == upstream.fetch("repository") &&
           witness.dig("releases", "packaged", "version") == packaged_version &&
           witness.dig("releases", "packaged", "tag") == packaged_tag &&
           witness.dig("releases", "packaged", "commit") == actual_packaged_commit &&
           witness.dig("releases", "latest", "version") == latest_version &&
           witness.dig("releases", "latest", "tag") == latest_tag &&
           witness.dig("releases", "latest", "commit") == latest_commit
      raise "OpenCode release witness does not match immutable tag commits"
    end
    expected_root = "opencode-#{latest_version}"
    archive_manifest = JSON.parse(
      verify_archive_identity(archive, repo, latest_commit, expected_root, limits: archive_limits),
    )
    raise "archive OpenCode version does not match #{latest_version}" unless archive_manifest.fetch("version") == latest_version

    changed_paths = git(repo, "diff", "--name-only", packaged_tag, latest_tag).lines.map(&:strip).reject(&:empty?).sort
    path_changes = RELEASE_SENSITIVE_PATHS.to_h do |path|
      [path, git(repo, "rev-parse", "#{packaged_tag}:#{path}") != git(repo, "rev-parse", "#{latest_tag}:#{path}")]
    end
    sensitive_blobs = RELEASE_SENSITIVE_PATHS.to_h do |path|
      [path, {
        "packaged" => git(repo, "rev-parse", "#{packaged_tag}:#{path}"),
        "latest" => git(repo, "rev-parse", "#{latest_tag}:#{path}"),
      }]
    end
    expected_sensitive_blobs = RELEASE_SENSITIVE_PATHS.to_h do |path|
      [path, {
        "packaged" => witness.dig("releases", "packaged", "release_sensitive_blobs", path),
        "latest" => witness.dig("releases", "latest", "release_sensitive_blobs", path),
      }]
    end
    raise "release-sensitive Git blobs do not match immutable witness" unless sensitive_blobs == expected_sensitive_blobs
    dependency_transition = mcp_dependency_transition(repo, packaged_tag, latest_tag)
    raise "MCP dependency sources do not match immutable witness" unless dependency_transition == witness["mcp_dependency_transition"]
    patch_inputs = packaging_patch_inputs(package_spec)

    {
      "schema" => RECEIPT_SCHEMA,
      "package" => "opencode",
      "immutable_witness" => {
        "path" => WITNESS_RELATIVE_PATH,
        "sha256" => expected_witness_sha256,
      },
      "packaged_release" => {
        "version" => packaged_version,
        "tag" => packaged_tag,
        "commit" => actual_packaged_commit,
        "archive_sha256" => upstream.fetch("source_sha256"),
      },
      "latest_release" => {
        "version" => latest_version,
        "tag" => latest_tag,
        "commit" => latest_commit,
        "archive_root" => expected_root,
        "archive_sha256" => Digest::SHA256.file(archive).hexdigest,
        "archive_matches_commit_tree" => true,
      },
      "packaging_patch_inputs" => patch_inputs,
      "delta" => {
        "changed_paths" => changed_paths.length,
        "release_sensitive_paths" => path_changes,
        "release_sensitive_blobs" => sensitive_blobs,
        "mcp_dependency_transition" => dependency_transition,
        "downstream_patch_revalidation_required" => patch_inputs.fetch("source0_revalidation_required"),
        "selected_source_evidence_refresh_required" => true,
      },
      "package_state" => {
        "status" => package.fetch("status"),
        "copr_enabled" => package.dig("copr", "enabled"),
        "blocked_state_preserved" => true,
      },
      "reproduction" => reproduction(upstream, latest_version),
    }
  end
end

if $PROGRAM_NAME == __FILE__
  options = {
    package_manifest: File.expand_path("../packages/opencode/package.yml", __dir__),
    package_spec: File.expand_path("../packages/opencode/opencode.spec", __dir__),
  }

  OptionParser.new do |parser|
    parser.banner = "Usage: scripts/audit-opencode-upstream-release --repo PATH --archive PATH --latest-version VERSION"
    parser.on("--package-manifest PATH", "OpenCode package.yml path") { |value| options[:package_manifest] = value }
    parser.on("--package-spec PATH", "OpenCode spec path") { |value| options[:package_spec] = value }
    parser.on("--repo PATH", "Local upstream Git repository") { |value| options[:repo] = value }
    parser.on("--archive PATH", "Downloaded latest release archive") { |value| options[:archive] = value }
    parser.on("--latest-version VERSION", "Latest released version") { |value| options[:latest_version] = value }
  end.parse!

  %i[repo archive latest_version].each do |key|
    raise OptionParser::MissingArgument, "--#{key.to_s.tr('_', '-')}" unless options[key]
  end

  puts JSON.pretty_generate(OpenCodeUpstreamReleaseAudit.audit(**options))
end
