        errors << "xberg: provider proof schema or gates are invalid" unless provider_proof["schema"] == "agentlab-xberg-provider-proof/v1" && provider_proof.fetch("providers").keys.sort == %w[fedora43 fedora44 rawhide] && provider_proof.dig("selected_graph") == { "registry_identities" => 597, "normal_packages" => 603, "normal_build_dev_packages" => 622, "resolver_only_registry_identities" => 437, "cargo_lock_sha256" => cargo.dig("source_evidence", "fedora_lock", "sha256"), "closure_sha256" => cargo.dig("source_evidence", "closure", "sha256"), "normal_identity_sha256" => "9f7b783531614c0a9460001ddae469dcd53ec02b37453db77f00896c72cb89fe", "normal_build_dev_identity_sha256" => "a49d533f5008678529641692a1951539120d35ccdb85197447c7aace5c954c91" } && provider_proof.fetch("validation").values.all? { |value| value == false } && provider_proof.dig("tree_sitter") == { "selected" => false, "omitted_from_initial_rpm" => true, "runtime_parser_pack_download" => false, "return_todo" => "Audit tree-sitter-language-pack 1.13.5 parser sources and licenses before restoring the feature." } && provider_proof.dig("model_runtime_policy") == { "build_downloads" => false, "model_weights_in_source" => false, "runtime_model_downloads" => "opt-in only for immutable checksum-verified content outside the RPM payload", "model_license_provenance_complete" => false, "tessdata_runtime_download" => false, "tessdata_provider" => "Fedora tesseract-langpack-* packages or an explicit local tessdata path", "offline_runtime_proof" => false }
        validate_xberg_patches_zero_fuzz!(package, errors, warnings)
    end
  end

  if package.name == "rtk"
    contract_config = package.data["source_contract"]
    contract_path = contract_config && File.join(package.directory, contract_config["file"])
    reproducibility = Agentlab.load_yaml(File.join(package.directory, "reproducibility.yml"))

    unless contract_path && File.file?(contract_path)
      errors << "rtk: source contract is missing"
    else
      errors << "rtk: source contract SHA-256 differs" unless Digest::SHA256.file(contract_path).hexdigest == contract_config["sha256"]

      begin
        contract = JSON.parse(File.read(contract_path))
        release = contract.fetch("release")
        target = contract.fetch("target_validation")
        expected_matrix = %w[fedora-43-x86_64 fedora-43-aarch64 fedora-44-x86_64 fedora-44-aarch64 fedora-rawhide-x86_64 fedora-rawhide-aarch64]
        expected_license_summary = [
          "(MIT OR Apache-2.0) AND Unicode-DFS-2016",
          "0BSD OR MIT OR Apache-2.0",
          "Apache 2.0",
          "Apache-2.0 AND ISC AND (MIT OR Apache-2.0)",
          "Apache-2.0 OR ISC OR MIT",
          "Apache-2.0 OR MIT",
          "Apache-2.0 WITH LLVM-exception OR Apache-2.0 OR MIT",
          "BSD-3-Clause",
          "CDLA-Permissive-2.0",
          "ISC",
          "MIT",
          "MIT OR Apache-2.0",
          "MIT OR Zlib OR Apache-2.0",
          "MPL-2.0",
          "Unicode-3.0",
          "Unlicense OR MIT",
          "Zlib"
        ]
        normalized_license_expressions = expected_license_summary.map do |expression|
          expression == "Apache 2.0" ? "Apache-2.0" : expression
        end
        expected_license_expression = normalized_license_expressions.map do |expression|
          expression.match?(/\s(?:AND|OR)\s/) ? "(#{expression})" : expression
        end.join(" AND ")
        expected_license_summary_text = "### BEGIN LICENSE SUMMARY ###\n#{expected_license_summary.map { |expression| "# #{expression}\n" }.join}###  END LICENSE SUMMARY  ###\n"

        errors << "rtk: source contract schema or release differs" unless contract["schema"] == "agentlab-rtk-source-contract/v1" && release.slice("name", "version", "tag", "commit") == { "name" => "rtk", "version" => "0.44.1", "tag" => "v0.44.1", "commit" => "36591fb00d650bf987b57483c0b3a395a35a8dc1" }
        errors << "rtk: source archive contract differs" unless release.slice("source_url", "source_sha256", "source_archive_tree_sha256", "source_archive_tree_files", "source_archive_tree_directories", "source_archive_tree_bytes", "tag_commit_tree_sha256") == { "source_url" => "https://github.com/rtk-ai/rtk/archive/refs/tags/v0.44.1.tar.gz", "source_sha256" => "735623ee670483216bc5fe7ca0885f1f1358d8f9facf22782a6ea8e8a44f3b3a", "source_archive_tree_sha256" => "8f31137e18556611e1ad93fa6f551899f3533aa7b38fd9413fe0157519a558f9", "source_archive_tree_files" => 76, "source_archive_tree_directories" => 8, "source_archive_tree_bytes" => 4_845_176, "tag_commit_tree_sha256" => "8f31137e18556611e1ad93fa6f551899f3533aa7b38fd9413fe0157519a558f9" }
        errors << "rtk: source archive is not bound to the local tag worktree" unless release["source_archive_tree_sha256"] == release["tag_commit_tree_sha256"] && release["tree_manifest_method"] == "sorted type<TAB>mode<TAB>path<TAB>bytes<TAB>sha256<LF> records over archive payload and git worktree excluding .git"
        errors << "rtk: upstream Cargo lock contract differs" unless contract["upstream_lock"] == { "file" => "Cargo.lock", "sha256" => "0e360b52a271c90275a73d56f016abdf60d80096a6cfdfb2767228b054b8fd45", "scope" => "pre-patch source identity only" }
        errors << "rtk: Rust source floor differs" unless contract["rust_contract"] == { "rust_version" => "1.91", "edition" => "2021" }
        errors << "rtk: patch source contract differs" unless contract["fedora_patches"] == [
          { "order" => 0, "file" => "rtk-use-system-sqlite.patch", "sha256" => "2496b4395840cc4ed84ba4e39124250336b10d03b321fbda2c62d7601b16f080", "purpose" => "disable rusqlite bundled SQLite and link Fedora system SQLite", "upstream_status" => "Fedora-specific; upstream PR #2404 commit d0a922f1cd04e343957b9b0b9603438677ad6353 is unreleased and retains bundled SQLite as the default" },
          { "order" => 1, "file" => "rtk-use-dirs6.patch", "sha256" => "826e2cd42dd4b70e6f8b50a178e5305c6946d81e219f1dd17e0cabe4d0e839b5", "purpose" => "select Fedora dirs 6 instead of dirs 5", "upstream_status" => "Fedora-specific; no upstream issue, pull request, or commit found as of 2026-07-31" }
        ]
        errors << "rtk: post-patch manifest contract differs" unless contract["post_patch_manifest"] == { "rusqlite" => { "version" => "0.31", "default_features" => true, "features" => [] }, "dirs" => "6", "colored" => "3", "which" => "8" }
        license_contract = contract.fetch("license_contract")
        license_summary_path = File.join(package.directory, license_contract.fetch("raw_summary_file"))
        errors << "rtk: target-license contract differs" unless license_contract == {
          "expression" => expected_license_expression,
          "raw_summary_file" => "rtk-0.44.1-license-summary.txt",
          "raw_summary_sha256" => "e511f9dc9f99a54e0746a392423f28718d5ea42a3d2f4995befc97c658c53832",
          "raw_summary_expressions" => expected_license_summary,
          "normalization" => "normalize the exact raw Apache 2.0 declaration to Apache-2.0, parenthesize compound expressions, and join every selected expression with AND without effective-license simplification",
          "basis" => "exact cargo2rpm all-target summary observed identically across Fedora 43, Fedora 44, and Rawhide on x86_64 and aarch64; future target builds must reproduce the checked summary and LICENSE.dependencies inventory",
          "final_linked_license" => false
        }
        errors << "rtk: target-license summary file is missing" unless File.file?(license_summary_path)
        if File.file?(license_summary_path)
          errors << "rtk: target-license summary text differs" unless File.read(license_summary_path) == expected_license_summary_text
          errors << "rtk: target-license summary SHA-256 differs" unless Digest::SHA256.file(license_summary_path).hexdigest == license_contract["raw_summary_sha256"]
        end
        errors << "rtk: target-license metadata differs" unless package.data.dig("license_audit", "expected_target_summary_file") == license_contract["raw_summary_file"] && package.data.dig("license_audit", "expected_target_summary_sha256") == license_contract["raw_summary_sha256"] && package.data.dig("license_audit", "normalized_aggregate_expression") == expected_license_expression
        errors << "rtk: duplicate contract differs" unless contract["duplicate_check"] == { "checked_on" => "2026-07-31", "fedora_43" => "absent", "fedora_44" => "absent", "rawhide" => "absent", "rpm_fusion_free" => "absent", "rpm_fusion_nonfree" => "absent", "path_provider" => "/usr/bin/rtk absent" }
        errors << "rtk: target providers differ" unless contract["target_providers"] == { "fedora_43" => { "rust" => "1.97.1-1.fc43", "cargo" => "1.97.1-1.fc43", "sqlite" => "3.50.2-2.fc43" }, "fedora_44" => { "rust" => "1.97.1-1.fc44", "cargo" => "1.97.1-1.fc44", "sqlite" => "3.51.2-1.fc44" }, "rawhide" => { "rust" => "1.97.1-2.fc45", "cargo" => "1.97.1-2.fc45", "sqlite" => "3.53.4-1.fc45" } }
        errors << "rtk: runtime source contract differs" unless contract["runtime_contract"] == { "system_sqlite_needed" => "libsqlite3.so.0", "forbid_rpath_runpath" => true, "tables" => %w[commands parse_failures], "columns" => { "commands" => %w[id timestamp original_cmd rtk_cmd input_tokens output_tokens saved_tokens savings_pct exec_time_ms project_path], "parse_failures" => %w[id timestamp raw_command error_message fallback_succeeded] }, "indexes" => %w[idx_pf_timestamp idx_project_path_timestamp idx_timestamp], "proxy_smoke" => { "command" => "true", "expected_total_records" => 1, "expected_matching_records" => 1, "input_tokens" => 0, "output_tokens" => 0, "saved_tokens" => 0 } }
        errors << "rtk: target validation gates are not fail-closed" unless %w[dependency_resolution generated_license_inventory final_linked_license cargo_tests payload sqlite_elf_linkage sqlite_schema_smoke cli_smoke proxy_smoke database_smoke].all? { |key| target[key] == false } && target.fetch("matrix").keys.sort == expected_matrix.sort && target.fetch("matrix").values.all? { |value| value == false }
      rescue JSON::ParserError, KeyError => error
        errors << "rtk: invalid source contract: #{error.message}"
      end
    end

    errors << "rtk: reproducibility spec or source contract hash differs" unless reproducibility["current_spec_sha256"] == Digest::SHA256.file(package.spec_path).hexdigest && reproducibility.dig("source_inputs", "source_contract", "sha256") == contract_config["sha256"]
    errors << "rtk: active release or upstream source differs" unless package.data.dig("build_validation", "release") == "0.44.1-0.2" && package.upstream.values_at("current_version", "source_sha256") == ["0.44.1", "735623ee670483216bc5fe7ca0885f1f1358d8f9facf22782a6ea8e8a44f3b3a"]
    current_family_flags = %w[fedora_43 fedora_44 rawhide].map { |family| package.data.dig("dependency_status", family, "current_release_verified") }
    system_sqlite_flags = package.data.dig("dependency_status", "system_sqlite").values_at("target_linkage_verified", "target_schema_verified")
    license_flags = package.data.fetch("license_audit").values_at("final_target_expression", "target_inventory_verified")
    errors << "rtk: active target gates are not fail-closed" unless package.data.dig("build_validation", "target").values.all? { |value| value == false } && current_family_flags.all? { |value| value == false } && system_sqlite_flags == [false, false] && license_flags == ["pending successful target LICENSE.dependencies verification", false] && package.data.dig("architecture_audit", "current_matrix_verified") == false
    errors << "rtk: historical build evidence was relabeled current" unless package.data["historical_build"] == { "release" => "0.43.0-0.6", "build_id" => 10749341, "status" => "succeeded", "scope" => "Fedora 43, Fedora 44, and Rawhide on x86_64 and aarch64" }
    errors << "rtk: current target validation is not pending" unless reproducibility.dig("validation", "current_release").values_at("nvr", "system_sqlite", "dirs6", "dependency_resolution", "generated_license_inventory", "final_linked_license", "cargo_tests", "payload", "sqlite_elf_linkage", "sqlite_schema_smoke", "cli_smoke", "proxy_smoke", "database_smoke", "matrix") == ["0.44.1-0.2", false, false, false, false, false, false, false, false, false, false, false, false, false]

    expected_spec_fragments = [
      "Source1:        rtk-%{version}-source-contract.json",
      "Source2:        rtk-%{version}-license-summary.txt",
      "%global source_contract_sha256 e8def35cf06f71dd38a77116abcf9d1702f2c37c1fea3324e32d440b5ec46f2a",
      "%global license_summary_sha256 e511f9dc9f99a54e0746a392423f28718d5ea42a3d2f4995befc97c658c53832",
      "%global system_sqlite_patch_sha256 2496b4395840cc4ed84ba4e39124250336b10d03b321fbda2c62d7601b16f080",
      "%global dirs6_patch_sha256 826e2cd42dd4b70e6f8b50a178e5305c6946d81e219f1dd17e0cabe4d0e839b5",
      "%global rtk_license_expression #{expected_license_expression}",
      "License:        %{rtk_license_expression}",
      "%autosetup -n %{crate}-%{version} -N",
      "%autopatch -p1",
      "%cargo_test",
      "test -s LICENSE.dependencies",
      "{\n%cargo_license_summary\n} > rtk-license-summary.actual",
      "cmp -s %{SOURCE2} rtk-license-summary.actual",
      "grep -Eq '\\(NEEDED\\).*\\[libsqlite3\\.so\\.0\\]' rtk-smoke.dynamic",
      "! grep -Eq '\\((RPATH|RUNPATH)\\)' rtk-smoke.dynamic",
      "select name from sqlite_master where type = 'table' order by name",
      "printf '%s\\n' commands parse_failures",
      "cmp -s rtk-smoke.expected-tables rtk-smoke.tables",
      "pragma_table_info('commands')",
      "id timestamp original_cmd rtk_cmd input_tokens output_tokens saved_tokens savings_pct exec_time_ms project_path",
      "pragma_table_info('parse_failures')",
      "id timestamp raw_command error_message fallback_succeeded",
      "idx_pf_timestamp idx_project_path_timestamp idx_timestamp",
      "select count(*) from commands",
      "test \"$command_records\" = \"1\"",
      "trim(original_cmd) = 'true'",
      "test \"$proxy_records\" = \"1\"",
      "RTK_TELEMETRY_DISABLED=1",
      "target/rpm/%{name} proxy true",
      "BuildRequires:  sqlite",
      "BuildRequires:  cargo >= 1.91",
      "BuildRequires:  rust >= 1.91"
    ]
    errors << "rtk: spec lacks the checked source/runtime contract" unless expected_spec_fragments.all? { |fragment| spec.include?(fragment) }
    patch0_index = spec.index("Patch0:         rtk-use-system-sqlite.patch")
    patch1_index = spec.index("Patch1:         rtk-use-dirs6.patch")
    dirs_hash_index = spec.index('echo "%{dirs6_patch_sha256}  %{PATCH1}" | sha256sum -c -')
    autopatch_index = spec.index("%autopatch -p1")
    errors << "rtk: patch order differs" unless patch0_index && patch1_index && patch0_index < patch1_index
    errors << "rtk: source hashes are not checked before patch application" unless dirs_hash_index && autopatch_index && dirs_hash_index < autopatch_index

    validate_patches_zero_fuzz!(
      package,
      source_env: "AGENTLAB_RTK_SOURCE0",
      source_root: "rtk-0.44.1",
      patches: %w[rtk-use-system-sqlite.patch rtk-use-dirs6.patch],
      errors: errors,
      warnings: warnings
    )
  end

  next unless Agentlab.command_available?("rpmspec")

  _stdout, stderr, status = Agentlab.capture(["rpmspec", "-P", package.spec_path])
  unless status.success?
    if (macro = Agentlab.unavailable_rpm_macro_parse_failure(package.spec_path, stderr))
      warnings << "#{package.name}: rpmspec parsing skipped because runner lacks Fedora macro %#{macro}"
    else
      errors << "#{package.name}: rpmspec parse failed: #{stderr.strip}"
    end
  end
end

unless selected_name
  active_names = packages.map(&:name)
  archive_root = File.join(Agentlab::ROOT, "archived")
  Dir.glob(File.join(archive_root, "*")).sort.each do |archive_directory|
    next unless File.directory?(archive_directory)

    archive_name = File.basename(archive_directory)
    manifest_path = File.join(archive_directory, "package.yml")
    retirement_path = File.join(archive_directory, "retirement.yml")
    unless File.file?(manifest_path)
      errors << "#{archive_name}: archived package is missing package.yml"
      next
    end

    manifest = Agentlab.load_yaml(manifest_path)

    errors << "#{archive_name}: package exists in both packages/ and archived/" if active_names.include?(archive_name)
    errors << "#{archive_name}: archived manifest name #{manifest['name'].inspect} does not match its directory" unless manifest["name"] == archive_name

    unless File.file?(retirement_path)
      errors << "#{archive_name}: archived package is missing retirement.yml"
      next
    end

    retirement = Agentlab.load_yaml(retirement_path)
    errors << "#{archive_name}: retirement name #{retirement['name'].inspect} does not match its directory" unless retirement["name"] == archive_name
    errors << "#{archive_name}: retirement date must use YYYY-MM-DD" unless retirement["retired_on"].to_s.match?(/\A\d{4}-\d{2}-\d{2}\z/)
    errors << "#{archive_name}: retirement reason is required" if retirement["reason"].to_s.strip.empty?
    errors << "#{archive_name}: retirement COPR project is required" if retirement["copr_project"].to_s.strip.empty?
    retirement_chroots = retirement["configured_chroots_at_retirement"]
    unless retirement_chroots.is_a?(Array) && retirement_chroots.any? && retirement_chroots.all? { |chroot| chroot.is_a?(String) && !chroot.empty? }
      errors << "#{archive_name}: retirement chroots must be a nonempty array of strings"
    end
  end
end

warnings << "rpmspec is unavailable; spec parsing was skipped" unless Agentlab.command_available?("rpmspec")

warnings.each { |warning| warn "warning: #{warning}" }
if errors.any?
  errors.each { |error| warn "error: #{error}" }
  exit 1
end

puts "Validated #{packages.length} package#{'s' unless packages.length == 1}."
