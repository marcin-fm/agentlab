      errors << "xberg: source link inventory is incomplete" unless filter["archive_link_inventory"] == { "symlinks" => 50, "hardlinks" => 0, "safe_in_root_links" => 49, "unsafe_links" => 1 }
    end
    cargo = package.data["cargo_source_contract"]
    unless cargo.is_a?(Hash)
      errors << "xberg: checked Cargo source contract is missing"
    else
      cargo.fetch("source_evidence", {}).each_value do |evidence|
        path = evidence.fetch("file").start_with?("scripts/") ? File.join(Agentlab::ROOT, evidence.fetch("file")) : File.join(package.directory, evidence.fetch("file"))
        errors << "xberg: missing Cargo evidence #{evidence.fetch('file')}" unless File.file?(path)
        errors << "xberg: stale Cargo evidence #{evidence.fetch('file')}" if File.file?(path) && Digest::SHA256.file(path).hexdigest != evidence.fetch("sha256")
      end
      closure = JSON.parse(File.read(File.join(package.directory, cargo.dig("source_evidence", "closure", "file"))))
      receipt = JSON.parse(File.read(File.join(package.directory, cargo.dig("source_evidence", "vendor_receipt", "file"))))
      license = JSON.parse(File.read(File.join(package.directory, cargo.dig("source_evidence", "license_text_presence", "file"))))
      selected_features = %w[formats analysis core-cli embeddings html url-ingestion liter-llm ocr paddle-ocr layout-detection chunking-tokenizers]
      errors << "xberg: Cargo source contract counts differ" unless [cargo["selected_registry_identities"], cargo["vendor_registry_identities"], cargo["resolver_only_registry_identities"], cargo["normal_packages"], cargo["normal_build_dev_packages"], cargo["git_dependencies"], cargo["ort_download_delta"], cargo["resolver_only_additions"]] == [597, 1_034, 437, 603, 622, 0, -2, 437]
      errors << "xberg: Cargo source contract does not declare canonical graph receipt v2" unless cargo["closure_schema"] == "agentlab-xberg-cargo-closure/v2" && cargo["graph_identity_serialization"] == "UTF-8 sorted unique name\\tversion\\n lines"
      errors << "xberg: Cargo resolver model is not selected-Fedora-workspace-lock complete" unless closure.dig("resolver_model", "kind") == "selected-Fedora-workspace-lock-complete" && closure.dig("counts", "selected_registry_identities") == 597 && closure.dig("counts", "vendor_registry_identities") == 1_034 && closure.dig("counts", "resolver_only_registry_identities") == 437 && closure.dig("counts", "root_lock_workspace") == 6
      errors << "xberg: Cargo closure schema is not canonical identity v2" unless closure["schema"] == "agentlab-xberg-cargo-closure/v2"
      errors << "xberg: Cargo graph counts differ" unless closure.fetch("counts").values_at("normal_packages", "normal_build_dev_packages", "git_dependencies") == [603, 622, 0]
      errors << "xberg: Cargo selected feature surface is incomplete" unless closure.dig("selection", "package") == "xberg-cli" && closure.dig("selection", "no_default_features") == true && closure.dig("selection", "features") == selected_features
      identities = closure.dig("selection", "registry_identities")
      errors << "xberg: selected registry identities are not sorted and unique" unless identities.is_a?(Array) && identities.length == 597 && identities.map { |item| [item["name"], item["version"]] } == identities.map { |item| [item["name"], item["version"]] }.uniq.sort
      outputs = closure["outputs"]
      errors << "xberg: Cargo graph identity receipt is incomplete" unless outputs.is_a?(Hash) && outputs.keys.sort == %w[identity_serialization normal_build_dev_identity_sha256 normal_identity_sha256] && outputs["identity_serialization"] == "UTF-8 sorted unique name\\tversion\\n lines" && outputs.values_at("normal_identity_sha256", "normal_build_dev_identity_sha256").all? { |value| value.match?(/\A[0-9a-f]{64}\z/) }
      errors << "xberg: Cargo graph identity hashes differ" unless outputs.values_at("normal_identity_sha256", "normal_build_dev_identity_sha256") == ["9f7b783531614c0a9460001ddae469dcd53ec02b37453db77f00896c72cb89fe", "a49d533f5008678529641692a1951539120d35ccdb85197447c7aace5c954c91"]
      errors << "xberg: Cargo vendor tree is not canonical" unless receipt["vendor_tree"] == cargo["vendor_tree"].merge("algorithm" => "sha256(sorted type,path,mode,link-target,size,content-sha256 records)")
      errors << "xberg: Cargo vendor tree counts differ" unless cargo["vendor_tree"] == { "sha256" => "fb5abc63d34135752002719a3910f4ecacb049c5292b5e0f5776d7350eea2917", "files" => 51_213, "directories" => 9_444, "symlinks" => 0, "bytes" => 1_099_639_051 }
      errors << "xberg: license text gaps are not retained" unless license["counts"] == { "present" => 959, "absent" => 75 } && license.dig("validation", "source_text_presence_verified") == true && license.dig("validation", "final_linked_license_complete") == false
      errors << "xberg: Cargo source contract license-gap roles differ" unless cargo["license_text_presence"] == { "present" => 959, "absent" => 75, "selected_normal_gaps" => 22, "resolver_only_gaps" => 53, "required_text_count" => 74, "final_linked_license_complete" => false }
      compile_contract = package.data["compile_proof_contract"]
      expected_compile_contract = {
         "package" => "xberg-cli",
         "no_default_features" => true,
         "features" => selected_features,
         "cargo_build" => "%cargo_build -- --package xberg-cli --no-default-features --features %{xberg_cli_features} --locked",
         "license_writer" => "scripts/write-xberg-cargo-license-receipts",
         "license_output" => "LICENSE.dependencies",
         "license_scope" => "cargo2rpm-equivalent target-all static dependency inventory; not final Linux linked-license evidence",
         "configured_scm_source_required" => true,
         "checked_vendor_required" => true,
         "offline_required" => true,
         "cli_smoke_required" => true,
         "dynamic_link_checks_required" => true,
         "deliberate_post_build_gate_required" => true,
         "rpm_installation_out_of_scope" => true,
         "final_linked_license_proof_required" => true,
         "runtime_smoke_required" => true,
         "full_matrix_required" => true
      }
      errors << "xberg: compile proof contract is incomplete" unless compile_contract == expected_compile_contract
      required = ["Source10:       %{name}-%{version}-fedora-Cargo.lock", "Source11:       %{name}-%{version}-provider-proof.json", "Source12:       %{name}-%{version}-source-license-receipt.json", "Source13:       %{name}-%{version}-fedora-license-allowlist.json", "Source14:       audit-xberg-proof-receipts", "Source15:       write-xberg-cargo-license-receipts", "Patch2:", "Patch3:", "Patch4:", "%setup -q -n xberg-%{version}", "--sanitize-only --source . --filter %{SOURCE9}", "%autopatch -p1", "install -pm0644 %{SOURCE10} Cargo.lock", "audit-xberg-cargo-closure --verify", "%cargo_prep -v cargo-vendor", "--prepared-source", "--vendor-dir", "test \"$(wc -l < %{SOURCE7})\" -eq 1034", "%cargo_build -- --package xberg-cli --no-default-features --features %{xberg_cli_features} --locked", "ruby .agentlab-source/write-xberg-cargo-license-receipts --output LICENSE.dependencies", "LICENSE.dependencies", "target/rpm/xberg --version", "ldd -r target/rpm/xberg", "readelf -d target/rpm/xberg", "exit 1"]
       errors << "xberg: spec lacks fail-closed Cargo vendor contract" unless required.all? { |fragment| spec.include?(fragment) }
       errors << "xberg: spec uses the broken Cargo macro package option" if spec.include?("%cargo_build_crate -n") || spec.include?("--features default")
       errors << "xberg: spec does not bind the exact selected feature surface" unless spec.include?("%global xberg_cli_features formats,analysis,core-cli,embeddings,html,url-ingestion,liter-llm,ocr,paddle-ocr,layout-detection,chunking-tokenizers")
       build_index = spec.index("%cargo_build -- --package xberg-cli --no-default-features --features %{xberg_cli_features} --locked")
       license_index = spec.index("ruby .agentlab-source/write-xberg-cargo-license-receipts --output LICENSE.dependencies")
       check_index = spec.index("%check")
       errors << "xberg: build and license commands do not precede the proof gate" unless build_index && license_index && check_index && build_index < license_index && license_index < check_index
      sanitize_index = spec.index("--sanitize-only --source . --filter %{SOURCE9}")
      autopatch_index = spec.index("%autopatch -p1")
      errors << "xberg: spec does not apply checked patches after sanitizing source links" unless sanitize_index && autopatch_index && sanitize_index < autopatch_index
      makefile = File.read(File.join(Agentlab::ROOT, ".copr", "Makefile"))
      errors << "xberg: SCM rule overwrites tracked Cargo evidence" if makefile.include?("--output-dir \"$$specdir\"")
      errors << "xberg: SCM rule does not compare Xberg evidence" unless makefile.include?("cmp \"$$tempdir/output/xberg-$$version-$$suffix\"")
      errors << "xberg: SCM rule does not supply the checked closure and link filter" unless makefile.include?("--closure \"$$specdir/xberg-$$version-cargo-closure.json\"") && makefile.include?("--filter \"$$specdir/xberg-$$version-source-filter.json\"")
       errors << "xberg: SCM rule lacks the Ruby selector provider" unless makefile.include?("cargo-rpm-macros curl ruby rubypick")
       errors << "xberg: SCM rule does not pass the checked Fedora lock" unless makefile.include?("--lock \"$$specdir/$$lock_file\"")
      errors << "xberg: SCM rule does not verify tracked proof receipts" unless makefile.include?("--provider \"$$specdir/xberg-$$version-provider-proof.json\"") && makefile.include?("--allowlist \"$$specdir/xberg-$$version-fedora-license-allowlist.json\"")
      errors << "xberg: SCM rule does not stage the checked Cargo license writer" unless makefile.include?("scripts/write-xberg-cargo-license-receipts")
      auditor = File.read(File.join(Agentlab::ROOT, "scripts", "audit-xberg-cargo-closure"))
       errors << "xberg: source extractor lacks receipt-driven safe link handling" unless ["safe_symlink_target", "safe_hardlink_target", "verify_unsafe_links!", "sanitize_tree!", "gnu_extension_value!", "pax_records!", "File.symlink(linkname, target)", "File.link(source, target)", "duplicate archive entry"].all? { |fragment| auditor.include?(fragment) }
       errors << "xberg: spec exits before the build gate" unless spec.index("exit 1") && spec.index("exit 1") > spec.index("%check")
      proof_auditor = File.read(File.join(Agentlab::ROOT, "scripts", "audit-xberg-proof-receipts"))
      errors << "xberg: proof auditor lacks tracked provider input" unless proof_auditor.include?("--provider PATH") && proof_auditor.include?("provider_receipt")
      errors << "xberg: proof auditor lacks prepared-source mode" unless proof_auditor.include?("--prepared-source DIR") && proof_auditor.include?("--vendor-dir DIR")
       errors << "xberg: proof auditor feature contract differs" unless ["VERSION = \"1.0.3\"", "REGISTRY = 1034", "SELECTED_REGISTRY = 597", "EXPECTED_GAPS = 75", "EXPECTED_SELECTED_GAPS = 22", "EXPECTED_RESOLVER_GAPS = 53", "NORMAL_PACKAGES = 603", "NORMAL_BUILD_DEV_PACKAGES = 622", "RESOLVER_ONLY_REGISTRY = 437", "9f7b783531614c0a9460001ddae469dcd53ec02b37453db77f00896c72cb89fe", "a49d533f5008678529641692a1951539120d35ccdb85197447c7aace5c954c91", "4e710a29f273b2cfa542ed8d6ee1f93a57c21168d49e7aa8b2cf5835ae297634", "054d4fa336f1a823babaa26eaad3c223fc0d54e6d4e898009aeec77e0301f0b2", "a27928a78f6f51296c0af68e82e9481e972a17c7e004b320d4bda600af9bcc20", "xberg-fedora-system-tessdata.patch"].all? { |fragment| proof_auditor.include?(fragment) }
      license_writer = File.read(File.join(Agentlab::ROOT, "scripts", "write-xberg-cargo-license-receipts"))
      license_writer_fragments = ["PACKAGE = \"xberg-cli\"", "FEATURES = %w[", '"--package=#{PACKAGE}"', '"--offline"', '"--locked"', '"--edges=no-build,no-dev,no-proc-macro"', '"--target=all"', '"--no-default-features"', '"--features=#{FEATURES.join(\',\')}"', 'line.end_with?(" (*)")', '.gsub(" / ", "/").gsub("/", " OR ")', 'File.write(output']
      errors << "xberg: Cargo license writer does not match the selected CLI contract" unless license_writer_fragments.all? { |fragment| license_writer.include?(fragment) }
       source_license = JSON.parse(File.read(File.join(package.directory, "xberg-1.0.3-source-license-receipt.json")))
       provider_proof = JSON.parse(File.read(File.join(package.directory, "xberg-1.0.3-provider-proof.json")))
         dynamic_tesseract_check_index = spec.index('echo "%{dynamic_tesseract_patch_sha256}  %{PATCH2}" | sha256sum -c -')
         selected_workspace_check_index = spec.index('echo "%{selected_workspace_patch_sha256}  %{PATCH3}" | sha256sum -c -')
         fedora_tessdata_check_index = spec.index('echo "%{fedora_tessdata_patch_sha256}  %{PATCH4}" | sha256sum -c -')
        errors << "xberg: spec does not bind dynamic Tesseract patch before applying patches" unless spec.include?("%global dynamic_tesseract_patch_sha256 4e710a29f273b2cfa542ed8d6ee1f93a57c21168d49e7aa8b2cf5835ae297634") && dynamic_tesseract_check_index && autopatch_index && dynamic_tesseract_check_index < autopatch_index
         errors << "xberg: spec does not bind selected workspace patch before applying patches" unless spec.include?("%global selected_workspace_patch_sha256 054d4fa336f1a823babaa26eaad3c223fc0d54e6d4e898009aeec77e0301f0b2") && selected_workspace_check_index && autopatch_index && selected_workspace_check_index < autopatch_index
         errors << "xberg: spec does not bind Fedora tessdata patch before applying patches" unless spec.include?("%global fedora_tessdata_patch_sha256 a27928a78f6f51296c0af68e82e9481e972a17c7e004b320d4bda600af9bcc20") && fedora_tessdata_check_index && autopatch_index && fedora_tessdata_check_index < autopatch_index
        errors << "xberg: explicit runtime provider dependencies are incomplete" unless spec.include?("Requires:       onnxruntime%{?_isa} >= 1.18") && spec.include?("Requires:       tesseract-langpack-eng") && package.data.dig("provider_contract", "runtime_requires") == ["onnxruntime%{?_isa} >= 1.18", "tesseract-langpack-eng"]
        dynamic_patch = File.read(File.join(package.directory, "xberg-dynamic-tesseract.patch"))
        dynamic_cfg = '+#[cfg(any(feature = "build-tesseract", feature = "build-tesseract-wasm", feature = "dynamic-linking"))]'
        errors << "xberg: dynamic Tesseract patch does not expose the complete runtime API" unless dynamic_patch.lines.count { |line| line.chomp == dynamic_cfg } == 14 && %w[api.rs leptonica.rs lib.rs result_iterator.rs].all? { |name| dynamic_patch.include?("crates/xberg-tesseract/src/#{name}") }
        errors << "xberg: dynamic Tesseract patch enables source-build machinery" if dynamic_patch.include?("crates/xberg-tesseract/build.rs")
        tessdata_patch_additions = File.readlines(File.join(package.directory, "xberg-fedora-system-tessdata.patch"), chomp: true).select { |line| line.start_with?("+") && !line.start_with?("+++") }.join("\n")
        errors << "xberg: Fedora tessdata patch adds mutable runtime download URLs" if tessdata_patch_additions.match?(%r{https?://|tessdata_fast})
       errors << "xberg: spec License differs from tracked source expression" unless spec.include?("License:        %{xberg_source_license_expression}") && spec.include?(source_license.fetch("source_package_expression").fetch("expression"))
       errors << "xberg: source-license receipt graph or gaps are invalid" unless source_license["schema"] == "agentlab-xberg-source-license-receipt/v1" && source_license["release"] == { "name" => "xberg", "version" => manifest_version, "target" => "x86_64-unknown-linux-gnu" } && source_license.dig("scope", "selected_package") == "xberg-cli" && source_license.dig("scope", "selected_features") == selected_features && source_license["graph"] == { "selected_registry_identities" => 597, "resolver_only_registry_identities" => 437, "normal_packages" => 603, "normal_build_dev_packages" => 622, "normal_identity_sha256" => "9f7b783531614c0a9460001ddae469dcd53ec02b37453db77f00896c72cb89fe", "normal_build_dev_identity_sha256" => "a49d533f5008678529641692a1951539120d35ccdb85197447c7aace5c954c91" } && source_license.dig("missing_text_gaps")&.slice("count", "selected_normal", "resolver_only", "required_text_count") == { "count" => 75, "selected_normal" => 22, "resolver_only" => 53, "required_text_count" => 74 } && source_license.dig("validation", "final_linked_license_complete") == false
       errors << "xberg: provider proof graph is stale" unless provider_proof.dig("selected_graph", "cargo_lock_sha256") == cargo.dig("source_evidence", "fedora_lock", "sha256") && provider_proof.dig("selected_graph", "closure_sha256") == cargo.dig("source_evidence", "closure", "sha256")
        errors << "xberg: provider proof schema or gates are invalid" unless provider_proof["schema"] == "agentlab-xberg-provider-proof/v1" && provider_proof.fetch("providers").keys.sort == %w[fedora43 fedora44 rawhide] && provider_proof.dig("selected_graph") == { "registry_identities" => 597, "normal_packages" => 603, "normal_build_dev_packages" => 622, "resolver_only_registry_identities" => 437, "cargo_lock_sha256" => cargo.dig("source_evidence", "fedora_lock", "sha256"), "closure_sha256" => cargo.dig("source_evidence", "closure", "sha256"), "normal_identity_sha256" => "9f7b783531614c0a9460001ddae469dcd53ec02b37453db77f00896c72cb89fe", "normal_build_dev_identity_sha256" => "a49d533f5008678529641692a1951539120d35ccdb85197447c7aace5c954c91" } && provider_proof.fetch("validation").values.all? { |value| value == false } && provider_proof.dig("tree_sitter") == { "selected" => false, "omitted_from_initial_rpm" => true, "runtime_parser_pack_download" => false, "return_todo" => "Audit tree-sitter-language-pack 1.13.5 parser sources and licenses before restoring the feature." } && provider_proof.dig("model_runtime_policy") == { "build_downloads" => false, "model_weights_in_source" => false, "runtime_model_downloads" => "opt-in only for immutable checksum-verified content outside the RPM payload", "model_license_provenance_complete" => false, "tessdata_runtime_download" => false, "tessdata_provider" => "Fedora tesseract-langpack-* packages or an explicit local tessdata path", "offline_runtime_proof" => false }
        validate_xberg_patches_zero_fuzz!(package, errors, warnings)
    end
  end

  next unless Agentlab.command_available?("rpmspec")

  _stdout, stderr, status = Agentlab.capture(["rpmspec", "-P", package.spec_path])
  unless status.success?
    if (macro = Agentlab.unavailable_rpm_macro_parse_failure(package.spec_path, stderr))
      warnings << "#{package.name}: rpmspec parsing skipped because runner lacks Fedora macro %#{macro}"
    else
      errors << "#{package.name}: rpmspec parse failed: #{stderr.strip}"
    end
  end
end

unless selected_name
  active_names = packages.map(&:name)
  archive_root = File.join(Agentlab::ROOT, "archived")
  Dir.glob(File.join(archive_root, "*")).sort.each do |archive_directory|
    next unless File.directory?(archive_directory)

    archive_name = File.basename(archive_directory)
    manifest_path = File.join(archive_directory, "package.yml")
    retirement_path = File.join(archive_directory, "retirement.yml")
    unless File.file?(manifest_path)
      errors << "#{archive_name}: archived package is missing package.yml"
      next
    end

    manifest = Agentlab.load_yaml(manifest_path)

    errors << "#{archive_name}: package exists in both packages/ and archived/" if active_names.include?(archive_name)
    errors << "#{archive_name}: archived manifest name #{manifest['name'].inspect} does not match its directory" unless manifest["name"] == archive_name

    unless File.file?(retirement_path)
      errors << "#{archive_name}: archived package is missing retirement.yml"
      next
    end

    retirement = Agentlab.load_yaml(retirement_path)
    errors << "#{archive_name}: retirement name #{retirement['name'].inspect} does not match its directory" unless retirement["name"] == archive_name
    errors << "#{archive_name}: retirement date must use YYYY-MM-DD" unless retirement["retired_on"].to_s.match?(/\A\d{4}-\d{2}-\d{2}\z/)
    errors << "#{archive_name}: retirement reason is required" if retirement["reason"].to_s.strip.empty?
    errors << "#{archive_name}: retirement COPR project is required" if retirement["copr_project"].to_s.strip.empty?
    retirement_chroots = retirement["configured_chroots_at_retirement"]
    unless retirement_chroots.is_a?(Array) && retirement_chroots.any? && retirement_chroots.all? { |chroot| chroot.is_a?(String) && !chroot.empty? }
      errors << "#{archive_name}: retirement chroots must be a nonempty array of strings"
    end
  end
end

warnings << "rpmspec is unavailable; spec parsing was skipped" unless Agentlab.command_available?("rpmspec")

warnings.each { |warning| warn "warning: #{warning}" }
if errors.any?
  errors.each { |error| warn "error: #{error}" }
  exit 1
end

puts "Validated #{packages.length} package#{'s' unless packages.length == 1}."
