#!/usr/bin/env ruby
# frozen_string_literal: true

require "optparse"
require_relative "lib/agentlab"
require_relative "lib/openchamber_licenses"

package = Agentlab.package_named("openchamber")
dependencies = Agentlab.load_yaml(File.join(package.directory, "dependencies.yml"))
version = package.upstream.fetch("current_version").to_s
selected_lock = File.join(package.directory, dependencies.dig("source_closure_files", "selected_lock_audit"))
source_audit = File.join(package.directory, dependencies.dig("source_closure_files", "source_audit"))
cache_dir = "/srv/tmp/agentlab-openchamber/source-acquisition-#{version}/archives"
receipt_path = File.join(package.directory, dependencies.dig("source_closure_files", "source_license_inventory"))
workdir = "/srv/tmp/agentlab-openchamber/source-license-inventory-#{version}"
check = false

OptionParser.new do |parser|
  parser.banner = "Usage: scripts/audit-openchamber-source-licenses [options]"
  parser.on("--cache-dir PATH", "Checked acquisition archive directory") { |path| cache_dir = path }
  parser.on("--receipt PATH", "Source-license inventory receipt path") { |path| receipt_path = path }
  parser.on("--workdir PATH", "Scratch directory below /srv/tmp") { |path| workdir = path }
  parser.on("--check", "Recreate and compare the checked receipt") { check = true }
end.parse!

receipt = Agentlab::OpenChamberLicenses.audit!(
  selected_lock_path: selected_lock,
  expected_selected_lock_sha256: dependencies.dig("selected_lock_receipt", "sha256"),
  source_audit_path: source_audit,
  expected_source_audit_sha256: dependencies.dig("source_acquisition_receipt", "sha256"),
  cache_dir: cache_dir,
  receipt_path: receipt_path,
  workdir: workdir,
  check: check
)
summary = receipt.fetch("summary")
puts "#{check ? 'Verified' : 'Wrote'} #{summary.fetch('unique_archives')} OpenChamber source-license archives for #{summary.fetch('selected_package_records')} selected package records (missing #{summary.fetch('sources_without_declared_license')}, ambiguous #{summary.fetch('ambiguous_declared_license_sources')}, non-SPDX #{summary.fetch('non_spdx_declared_license_sources')})."
