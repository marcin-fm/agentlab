#!/usr/bin/env ruby
# frozen_string_literal: true

require "digest"
require "json"
require "optparse"

module XbergModelSource
  VERSION = "1.0.3"
  SOURCE_COMMIT = "37b9fee5762450351e9303243a00e51184a1f24b"
  SOURCE_SHA256 = "238b8087a398b7753562b341abf082c8305a0359786424976909dc59b251058e"
  MIRROR_REPOSITORY = "xberg-io/embedding-models"
  MIRROR_REVISION = "4b127809f88a5aa1569d1238032b5ff40e5879bc"
  UPSTREAM_REPOSITORY = "minishlab/potion-base-8M"
  UPSTREAM_REVISION = "bf8b056651a2c21b8d2565580b8569da283cab23"
  RELEASED_WITNESS_SHA256 = "ca8b4e16be0c1bdee3f9d61b39f281503c9ca430da5075616d190eed38c053ef"
  MIRROR_RESPONSE_SHA256 = "c89ffc17e03f0da7e14647d24101eb0ff3894bbdf8185e41de1ee1df3ce674e1"
  UPSTREAM_RESPONSE_SHA256 = "f8fa3acf4134b56b6d1b1f6facc60ac8b94266fc2fa5e2d3e79152101938e75e"
  README_SHA256 = "de8ec91bf63c5f4c0e20751c227b2d049953e1cab5f8d5d44211c59a44795bdd"
  MIRROR_FILES = {
    "config.json" => { "oid" => "7df26884a1aaaefbd7a30b37c32a25477cfb4c0e", "bytes" => 202, "sha256" => "2a6ac0e9aaa356a68a5688070db78fc3a464fefe85d2f06a1905ce3718687553" },
    "model.safetensors" => { "oid" => "c1009c715b593a264bfd06c93b600e786889cf7a", "bytes" => 30_236_760, "sha256" => "f65d0f325faadc1e121c319e2faa41170d3fa07d8c89abd48ca5358d9a223de2" },
    "special_tokens_map.json" => { "oid" => "ea5749ac4944681a4041bb1f9a446137f4f61447", "bytes" => 134, "sha256" => "a9e8fb6f99fb0b8803f0e6942fdf4d95d6645204620b67dc3310a1024bcbac59" }
  }.freeze
  UPSTREAM_ONLY_FILES = {
    "tokenizer.json" => { "oid" => "3e511f68ccf95c33b9ffd214a94c6d25bdb3034f", "bytes" => 683_666, "sha256" => "e67e803f624fb4d67dea1c730d06e1067e1b14d830e2c2202569e3ef0f70bb50" },
    "tokenizer_config.json" => { "oid" => "438de4d478304fd499f1ef3f6f7fe38acd7a9620", "bytes" => 1_431, "sha256" => "6725995e3ab3039857ff5bd99178a7cdf42863abb04449e7bb31feb1f55fe567" },
    "vocab.txt" => { "oid" => "2f988cb392c3cd1152363bf737816e3530179fa1", "bytes" => 219_690, "sha256" => "1394523a67ddd404a825428018c0582a6998bcfa044ecbcbf1f4d71adb94c61c" }
  }.freeze
  RUNTIME_FILES = %w[model.safetensors tokenizer.json config.json].freeze

  module_function

  def ensure!(condition, message)
    raise ArgumentError, message unless condition
  end

  def sha256(path)
    Digest::SHA256.file(path).hexdigest
  end

  def parse_json(path, label)
    ensure!(File.file?(path), "missing #{label}: #{path}")
    JSON.parse(File.binread(path))
  rescue JSON::ParserError => e
    raise ArgumentError, "invalid #{label} JSON: #{e.message}"
  end

  def validate_released_witness(path)
    witness = parse_json(path, "released source witness")
    ensure!(sha256(path) == RELEASED_WITNESS_SHA256, "released source witness response checksum differs")
    ensure!(witness["schema"] == "agentlab-xberg-released-model-source-witness/v1", "released source witness schema differs")
    ensure!(witness["source"] == { "version" => VERSION, "commit" => SOURCE_COMMIT, "archive_sha256" => SOURCE_SHA256 }, "released source identity differs")
    preset = witness.fetch("preset")
    ensure!(preset.values_at("name", "repository", "revision", "model_file") == ["lightweight", MIRROR_REPOSITORY, MIRROR_REVISION, "potion-base-8m/model.safetensors"], "released lightweight preset differs")
    ensure!(preset["runtime_files"] == RUNTIME_FILES, "released runtime file set differs")
    expected_candidates = RUNTIME_FILES.to_h { |name| [name, ["potion-base-8m/#{name}", name]] }
    ensure!(preset["fetch_candidates"] == expected_candidates, "released fetch candidates differ")
    expected_manifest = (MIRROR_FILES.merge(UPSTREAM_ONLY_FILES)).to_h { |name, record| ["potion-base-8m/#{name}", record.fetch("sha256")] }
    ensure!(witness["manifest"] == expected_manifest, "released checksum manifest differs")
    witness
  end

  def validate_tree(path, label:, repository:, revision:, expected:, response_sha256:, path_prefix: "", api_path: nil)
    rows = parse_json(path, "#{label} tree response")
    actual_response_sha256 = sha256(path)
    ensure!(rows.is_a?(Array), "#{label} tree response is not an array")
    files = rows.select { |row| row["type"] == "file" }
    expected_paths = expected.to_h { |name, identity| ["#{path_prefix}#{name}", identity] }
    actual = files.to_h { |row| [row.fetch("path"), row] }
    ensure!(actual.keys.sort == expected_paths.keys.sort, "#{label} tree file set differs")
    expected_paths.each do |name, identity|
      row = actual.fetch(name)
      ensure!(row["oid"] == identity.fetch("oid"), "#{label} object id differs: #{name}")
      ensure!(row["size"] == identity.fetch("bytes"), "#{label} object size differs: #{name}")
      if File.basename(name) == "model.safetensors"
        ensure!(row.dig("lfs", "oid") == identity.fetch("sha256"), "#{label} LFS object differs: #{name}")
        ensure!(row.dig("lfs", "size") == identity.fetch("bytes"), "#{label} LFS size differs: #{name}")
      end
    end
    ensure!(actual_response_sha256 == response_sha256, "#{label} tree response checksum differs")
    {
      "api_url" => "https://huggingface.co/api/models/#{repository}/tree/#{revision}#{api_path ? "/#{api_path}" : ""}?recursive=true",
      "revision" => revision,
      "response_sha256" => actual_response_sha256,
      "regular_files" => files.length,
      "objects" => expected_paths.sort.to_h
    }
  end

  def upstream_expected
    MIRROR_FILES.merge(UPSTREAM_ONLY_FILES).merge(
      ".gitattributes" => { "oid" => "a6344aac8c09253b3b630fb776ae94478aa0275b", "bytes" => 1_519 },
      "README.md" => { "oid" => "a15b68310f32625ba859c23b629824b03091427b", "bytes" => 5_203 },
      "modules.json" => { "oid" => "87267c74884fa9da7667436a871449167532bca2", "bytes" => 278 },
      "onnx/model.onnx" => { "oid" => "975e384201f4a58a73772242f4797ab37464bdff", "bytes" => 30_240_854 }
    )
  end

  def build(released_witness:, mirror_tree:, upstream_tree:, upstream_readme:)
    released = validate_released_witness(released_witness)
    mirror = validate_tree(mirror_tree, label: "mirror", repository: MIRROR_REPOSITORY, revision: MIRROR_REVISION, expected: MIRROR_FILES, response_sha256: MIRROR_RESPONSE_SHA256, path_prefix: "potion-base-8m/", api_path: "potion-base-8m")
    upstream = validate_tree(upstream_tree, label: "upstream", repository: UPSTREAM_REPOSITORY, revision: UPSTREAM_REVISION, expected: upstream_expected, response_sha256: UPSTREAM_RESPONSE_SHA256)
    ensure!(File.file?(upstream_readme), "missing upstream model card: #{upstream_readme}")
    readme = File.binread(upstream_readme).delete_suffix("\n")
    ensure!(Digest::SHA256.hexdigest(readme) == README_SHA256, "upstream model card checksum mismatch")
    front_matter = readme.split(/^---\s*$/, 3)[1]
    ensure!(front_matter&.match?(/^license:\s*mit\s*$/i), "upstream model card does not declare MIT")

    mirror_files = MIRROR_FILES.sort.map do |name, identity|
      {
        "path" => "potion-base-8m/#{name}",
        "upstream_path" => name,
        "runtime_required" => RUNTIME_FILES.include?(name),
        "identity" => identity
      }
    end
    upstream_only = UPSTREAM_ONLY_FILES.sort.map do |name, identity|
      {
        "path" => name,
        "released_manifest_path" => "potion-base-8m/#{name}",
        "runtime_required" => RUNTIME_FILES.include?(name),
        "released_download_path_established" => false,
        "identity" => identity
      }
    end

    {
      "schema" => "agentlab-xberg-model-source/v2",
      "xberg" => released.fetch("source").merge("released_source_witness_sha256" => sha256(released_witness)),
      "preset" => released.fetch("preset").slice("name", "repository", "revision", "model_file", "runtime_files", "fetch_candidates"),
      "mirror" => { "repository" => MIRROR_REPOSITORY, "tree" => mirror, "provided_files" => mirror_files },
      "upstream" => {
        "repository" => UPSTREAM_REPOSITORY,
        "revision" => UPSTREAM_REVISION,
        "tree" => upstream,
        "upstream_only_files" => upstream_only,
        "license" => {
          "declared_spdx" => "MIT",
          "declaration_source" => { "path" => "README.md", "bytes" => readme.bytesize, "sha256" => README_SHA256 },
          "license_text_present" => false,
          "license_text_resolution_complete" => false
        }
      },
      "claims" => {
        "released_source_witness_bound" => true,
        "mirror_tree_response_bound" => true,
        "upstream_tree_response_bound" => true,
        "mirror_provided_identity_complete" => true,
        "upstream_only_identity_complete" => true,
        "released_runtime_file_set_available_at_mirror_revision" => false,
        "released_upstream_direct_fallback_established" => false,
        "lightweight_preset_source_identity_complete" => false,
        "conversion_required_for_mirror_model" => false,
        "training_data_provenance_complete" => false,
        "model_license_provenance_complete" => false,
        "redistribution_review_complete" => false,
        "runtime_download_proof_complete" => false,
        "offline_runtime_proof_complete" => false,
        "rpm_payload_observed" => false,
        "final_linked_license_complete" => false
      }
    }
  end
end

if $PROGRAM_NAME == __FILE__
  options = {}
  OptionParser.new do |parser|
    parser.banner = "Usage: audit-xberg-model-source --released-witness PATH --mirror-tree PATH --upstream-tree PATH --upstream-readme PATH --output PATH"
    parser.on("--released-witness PATH") { |value| options[:released_witness] = value }
    parser.on("--mirror-tree PATH") { |value| options[:mirror_tree] = value }
    parser.on("--upstream-tree PATH") { |value| options[:upstream_tree] = value }
    parser.on("--upstream-readme PATH") { |value| options[:upstream_readme] = value }
    parser.on("--output PATH") { |value| options[:output] = value }
  end.parse!
  missing = %i[released_witness mirror_tree upstream_tree upstream_readme output].reject { |key| options[key] }
  abort("missing options: #{missing.join(', ')}") unless missing.empty?

  output = options.delete(:output)
  File.write(output, JSON.generate(XbergModelSource.build(**options)) + "\n")
end
