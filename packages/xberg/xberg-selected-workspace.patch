diff --git a/crates/xberg/Cargo.toml b/crates/xberg/Cargo.toml
--- a/crates/xberg/Cargo.toml
+++ b/crates/xberg/Cargo.toml
index 0c01f6e..8041ad0 100644
@@ -150,45 +150,6 @@ wordperfect = ["dep:xberg-libwpd"]
 # PaddleOCR type definitions only — pure-Rust config structs, no ORT dependency.
 # Exposes PaddleOcrConfig, PaddleLanguage, ModelPaths. Safe on Android/WASM.
 paddle-ocr-types = []
-# Candle-based VLM OCR backends. Pure-Rust transformer inference via candle —
-# no ORT, no native binaries. Compatible with `ort-bundled` / `paddle-ocr`;
-# multiple OCR backends can be registered side-by-side.
-#
-# Per-model sub-features live in xberg-candle-ocr; enable them via
-# `--features candle-ocr,xberg-candle-ocr/trocr` or by depending on
-# xberg-candle-ocr directly with the sub-feature.
-candle-ocr = [
-    "dep:xberg-candle-ocr",
-    "dep:image",
-    "dep:hf-hub",
-    "dep:reqwest",
-    "dep:sha2",
-    "dep:fs2",
-    "ocr-pipeline",
-    "tokio-runtime",
-]
-# TrOCR backend: aggregate feature enabling candle-ocr with trocr sub-feature
-candle-trocr = ["candle-ocr", "xberg-candle-ocr/trocr"]
-# PaddleOCR-VL backend: aggregate feature enabling candle-ocr with paddleocr-vl sub-feature
-candle-paddleocr-vl = ["candle-ocr", "xberg-candle-ocr/paddleocr-vl"]
-# GLM-OCR backend: aggregate feature enabling candle-ocr with glm-ocr sub-feature; requires layout-detection for paired dispatch
-candle-glm-ocr = ["candle-ocr", "xberg-candle-ocr/glm-ocr", "layout-detection"]
-# DeepSeek-OCR backend: aggregate feature enabling candle-ocr with deepseek-ocr sub-feature
-candle-deepseek-ocr = ["candle-ocr", "xberg-candle-ocr/deepseek-ocr"]
-# Umbrella aggregate for all candle VLM OCR backends (not in full/formats/wasm-target/android-target)
-candle-vlm-ocr = [
-    "candle-deepseek-ocr",
-    "candle-paddleocr-vl",
-    "candle-glm-ocr",
-    "candle-trocr",
-]
-# Candle GPU acceleration pass-throughs. Enable alongside any candle-* backend
-# to compile the corresponding candle backend (CUDA / Metal / Accelerate /
-# MKL) — CPU decode of the larger VLM backends is impractically slow.
-candle-cuda = ["candle-ocr", "xberg-candle-ocr/cuda"]
-candle-metal = ["candle-ocr", "xberg-candle-ocr/metal"]
-candle-accelerate = ["candle-ocr", "xberg-candle-ocr/accelerate"]
-candle-mkl = ["candle-ocr", "xberg-candle-ocr/mkl"]
 # PaddleOCR via ONNX Runtime
 # Requires 'ocr' feature for shared conversion utilities and table reconstruction
 paddle-ocr = [
@@ -981,7 +942,6 @@ tokenizers = { version = "0.23", default-features = false, features = ["fancy-re
 # Note: candle-core unconditionally links platform-specific deps (cudarc on Linux, metal-kernels on macOS).
 # To avoid conflicts during feature unification, GPU features (candle-cuda/metal/mkl/accelerate) should
 # only be explicitly enabled with platform awareness. CI uses `--features full` which excludes GPU accel.
-xberg-candle-ocr = { path = "../xberg-candle-ocr", version = "1.0.1", optional = true }
 # PaddleOCR via ONNX Runtime - not available on WASM (vendored from paddle-ocr-rs)
 xberg-paddle-ocr = { path = "../xberg-paddle-ocr", version = "1.0.1", optional = true }
 
@@ -1012,7 +972,6 @@ ureq = { version = "3.3", default-features = false, features = [
     "json",
 ], optional = true }
 # Candle-based VLM OCR backends - pure-Rust transformer inference, not on WASM yet.
-xberg-candle-ocr = { path = "../xberg-candle-ocr", version = "1.0.1", optional = true }
 # PaddleOCR via ONNX Runtime - not available on WASM (vendored from paddle-ocr-rs)
 xberg-paddle-ocr = { path = "../xberg-paddle-ocr", version = "1.0.1", optional = true }
 
