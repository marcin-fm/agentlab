From: Marcin FM <marcin@lgic.pl>
Subject: [PATCH] Use dynamic ONNX Runtime for default CLI ML features

Fedora supplies ONNX Runtime as a system library. Keep the released default
CLI capabilities while selecting Xberg's existing dynamic ORT configuration
instead of the upstream prebuilt-runtime download path.

Fedora-specific; not submitted upstream. Local Xberg history contains existing
dynamic ORT support for other release targets, but no released/default-Linux
feature-edge change.

diff --git a/crates/xberg/Cargo.toml b/crates/xberg/Cargo.toml
--- a/crates/xberg/Cargo.toml
+++ b/crates/xberg/Cargo.toml
@@ -224,11 +224,11 @@ auto-rotate = [
     "dep:reqwest",
     "dep:sha2",
     "dep:fs2",
     "dep:image",
     "dep:ureq",
-    "ort-bundled",
+    "ort-dynamic",
 ]
 layout-detection = [
     "layout-types",
     "dep:fs2",
     "dep:ort",
@@ -236,11 +236,11 @@ layout-detection = [
     "dep:hf-hub",
     "dep:reqwest",
     "dep:sha2",
     "dep:image",
     "tokio-runtime",
-    "ort-bundled",
+    "ort-dynamic",
 ]
 # layout-tract: no-ORT sibling of `layout-detection` (issue #1275, Phase 5). Runs RT-DETR
 # layout detection and the PP-LCNet table (wired/wireless) classifier through the pure-Rust
 # `tract` engine instead of ONNX Runtime, so it builds on no-ORT targets (Android x86_64
 # emulator). Table STRUCTURE recognition (TATR, SLANeXT) and PP-DocLayout-V3 stay ORT-only —
@@ -344,11 +344,11 @@ onnx-runtime = [
     "dep:reqwest",
     "dep:ort",
     "dep:tokenizers",
     "dep:sha2",
     "dep:fs2",
-    "ort-bundled",
+    "ort-dynamic",
 ]
 # embedding-presets: static preset metadata (WASM-safe, no ORT)
 embedding-presets = []
 # embeddings: full embedding generation with ONNX Runtime (ORT-dependent, WASM-incompatible)
 # NOTE: embedding-presets is a subset of embeddings (no ORT); always implied by embeddings.
