+const normalizeMetafilePath = (value: string) => {
+  if (value === sourceRoot) return "$SOURCE_ROOT"
+  if (!value.startsWith(sourceRoot + path.sep)) return value
+  return `$SOURCE_ROOT/${path.relative(sourceRoot, value).replaceAll("\\", "/")}`
+}
+
+const canonicalize = (value: unknown): unknown => {
+  if (Array.isArray(value)) return value.map(canonicalize)
+  if (typeof value === "string") return normalizeMetafilePath(value)
+  if (!value || typeof value !== "object") return value
+  return Object.fromEntries(
+    Object.entries(value)
+      .map(([key, nested]) => [normalizeMetafilePath(key), canonicalize(nested)] as const)
+      .sort(([left], [right]) => (left < right ? -1 : left > right ? 1 : 0)),
+  )
+}
 
